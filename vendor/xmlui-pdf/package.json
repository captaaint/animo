{
  "name": "xmlui-pdf",
  "version": "0.1.14",
  "private": true,
  "type": "module",
  "description": "Vendored fork of xmlui-pdf (xmlui-org/xmlui packages/xmlui-pdf) — see README.md.",
  "license": "MIT",
  "sideEffects": [
    "**/*.css"
  ],
  "exports": {
    ".": {
      "types": "./src/index.tsx",
      "default": "./dist/xmlui-pdf.mjs"
    },
    "./*.css": "./dist/*.css"
  },
  "scripts": {
    "build:extension": "xmlui build-lib",
    "build-watch": "xmlui build-lib --watch"
  },
  "dependencies": {
    "pdf-lib": "1.17.1",
    "pdfjs-dist": "5.4.296",
    "react-pdf": "^10.3.0"
  },
  "devDependencies": {
    "xmlui": "*"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=18.0.0"
  }
}
