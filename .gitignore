website/dist-ssg/

# Turborepo local task cache (machine-specific hashes, regenerated by
# `turbo run`). Anywhere in the workspace — including app/, website/,
# extensions/* — never useful in the remote repo.
**/.turbo/

# Synced desktop release artifacts (pulled fresh at build time from GitHub
# Releases by website/scripts/sync-downloads.mjs). Only the manifest.json
# is committed.
website/public/downloads/v*/

# Logs
logs
yarn-debug.log*
dev-debug.log
