{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Animo",
  "version": "0.2.9",
  "identifier": "app.getanimo.timetracker",
  "build": {
    "beforeDevCommand": "npm --prefix app run start",
    "beforeBuildCommand": "npm --prefix app run build-prod",
    "devUrl": "http://localhost:5173",
    "frontendDist": "../app/dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Animo",
        "width": 1200,
        "height": 800,
        "minWidth": 800,
        "minHeight": 500,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": false,
    "targets": [
      "dmg",
      "app",
      "msi",
      "deb",
      "appimage"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "copyright": "© 2026 Animo",
    "category": "Productivity",
    "shortDescription": "Animo — time tracker (XMLUI + axum + Tauri)",
    "longDescription": "Animo is a self-hosted time tracker with projects, clients, tags, and detailed PDF reports. Runs entirely on the local machine."
  },
  "plugins": {
    "updater": {
      "pubkey": "TAURI_UPDATER_PUBKEY_SET_BY_RELEASE_WORKFLOW",
      "endpoints": [
        "https://getanimo.app/updates/latest.json"
      ]
    }
  }
}
