{
  "$schema": "https://turborepo.com/schema.json",
  "ui": "tui",
  "globalEnv": [
    "CI",
    "VITE_ANIMO_DEMO",
    "VITE_ANIMO_DEMO_URL",
    "VITE_ANIMO_VERSION",
    "VITE_ANIMO_HASH_ROUTING"
  ],
  "tasks": {
    "build": {
      "inputs": [
        "$TURBO_DEFAULT$",
        "!**/*.spec.ts",
        "!**/*.test.ts",
        "!dist/**",
        "!dist-ssg/**"
      ],
      "outputs": [
        "dist/**"
      ]
    },
    "build-prod": {
      "inputs": [
        "$TURBO_DEFAULT$",
        "!**/*.spec.ts",
        "!**/*.test.ts",
        "!dist/**",
        "!dist-ssg/**"
      ],
      "outputs": [
        "dist/**"
      ]
    },
    "build:demo": {
      "inputs": [
        "$TURBO_DEFAULT$",
        "!**/*.spec.ts",
        "!**/*.test.ts",
        "!dist/**",
        "!dist-ssg/**"
      ],
      "outputs": [
        "dist/**"
      ]
    },
    "build:website": {
      "inputs": [
        "$TURBO_DEFAULT$",
        "!**/*.spec.ts",
        "!**/*.test.ts",
        "!dist/**",
        "!dist-ssg/**"
      ],
      "outputs": [
        "dist-ssg/**"
      ],
      "passThroughEnv": [
        "GITHUB_TOKEN",
        "GH_TOKEN",
        "VERSION",
        "REPO"
      ]
    },
    "check": {
      "inputs": [
        "$TURBO_DEFAULT$",
        "!**/*.spec.ts",
        "!**/*.test.ts",
        "!dist/**",
        "!dist-ssg/**"
      ],
      "outputs": []
    }
  }
}
