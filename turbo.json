{
  "$schema": "https://turborepo.com/schema.json",
  "ui": "tui",
  "globalEnv": ["CI", "VITE_ANIMO_DEMO", "VITE_ANIMO_DEMO_URL", "VITE_ANIMO_VERSION", "VITE_ANIMO_HASH_ROUTING"],
  "tasks": {
    "build:extension": {
      "inputs": ["$TURBO_DEFAULT$", "!**/*.spec.ts", "!**/*.test.ts"],
      "outputs": ["dist/**"]
    },
    "build": {
      "inputs": [
        "$TURBO_DEFAULT$",
        "!**/*.spec.ts",
        "!**/*.test.ts",
        "!dist/**",
        "!dist-ssg/**"
      ],
      "dependsOn": ["^build:extension"],
      "outputs": ["dist/**"]
    },
    "build-prod": {
      "inputs": [
        "$TURBO_DEFAULT$",
        "!**/*.spec.ts",
        "!**/*.test.ts",
        "!dist/**",
        "!dist-ssg/**"
      ],
      "dependsOn": ["^build:extension"],
      "outputs": ["dist/**"]
    },
    "build:demo": {
      "inputs": [
        "$TURBO_DEFAULT$",
        "!**/*.spec.ts",
        "!**/*.test.ts",
        "!dist/**",
        "!dist-ssg/**"
      ],
      "dependsOn": ["^build:extension"],
      "outputs": ["dist/**"]
    },
    "build:with-demo": {
      "inputs": [
        "$TURBO_DEFAULT$",
        "!**/*.spec.ts",
        "!**/*.test.ts",
        "!dist/**",
        "!dist-ssg/**"
      ],
      "dependsOn": ["^build:extension"],
      "outputs": ["dist-ssg/**"]
    },
    "check": {
      "inputs": ["$TURBO_DEFAULT$", "!**/*.spec.ts", "!**/*.test.ts", "!dist/**", "!dist-ssg/**"],
      "outputs": []
    }
  }
}
