<App
  layout="vertical-sticky"
  scrollWholePage="true"
  global.apiBase="{window.__ANIMO_API_BASE__ || 'http://127.0.0.1:8080/api'}"
  global.pageTitle="{pageTitleFromPath(window.location.pathname)}"
  global.entriesTick="{0}"
  onDidNavigate="(to) => pageTitle = pageTitleFromPath(to)"
>
  <LocalUserGate id="localUser" apiBase="{apiBase}" />
  <Viewport id="appVp" />

  <DataSource
    id="appProjectsDs"
    url="{apiBase + '/projects'}"
    credentials="include"
    when="{localUser.value && localUser.value.kind === 'ready'}"
  />
  <DataSource
    id="appClientsDs"
    url="{apiBase + '/clients'}"
    credentials="include"
    when="{localUser.value && localUser.value.kind === 'ready'}"
  />
  <DataSource
    id="appTagsDs"
    url="{apiBase + '/tags'}"
    credentials="include"
    when="{localUser.value && localUser.value.kind === 'ready'}"
  />
  <TonePersist id="tone" />

  <Stack
    when="{!localUser.value || localUser.value.kind === 'bootstrapping'}"
    width="*"
    height="100vh"
    verticalAlignment="center"
    horizontalAlignment="center"
  >
    <Spinner />
  </Stack>

  <HStack
    when="{localUser.value && localUser.value.kind === 'needs-setup'}"
    width="*"
    minHeight="100vh"
    horizontalAlignment="center"
    verticalAlignment="center"
    padding="$space-4"
  >
    <Card maxWidth="440px" width="*" padding="$space-5" gap="$space-4">
      <VStack gap="$space-1">
        <Text fontWeight="700" fontSize="$fontSize-large">Welcome to Animo</Text>
        <Text variant="secondary" fontSize="$fontSize-small">
          Let's set up your local profile. It stays on this device and scopes
          your time tracking to you.
        </Text>
      </VStack>
      <Form
        data="{{ name: '', username: '' }}"
        hideButtonRow="true"
        onSubmit="(data) => localUser.createUser(data.name, data.username)"
      >
        <TextBox bindTo="name" label="Display name" required="true" autoFocus="true" maxLength="100" />
        <TextBox bindTo="username" label="Username" required="true" maxLength="30" />
        <Text variant="secondary" fontSize="$fontSize-small">
          Lowercase letters, numbers, and underscores recommended (3-30 chars).
        </Text>
        <Text
          when="{localUser.value && localUser.value.error}"
          color="$color-danger-600"
          fontSize="$fontSize-small"
        >
          {localUser.value.error}
        </Text>
        <Button
          type="submit"
          label="{localUser.value && localUser.value.loading ? 'Creating...' : 'Get Started'}"
          themeColor="primary"
          enabled="{!(localUser.value && localUser.value.loading)}"
        />
      </Form>
    </Card>
  </HStack>

  <AppHeader when="{localUser.value && localUser.value.kind === 'ready'}">
    <!-- Fixed width so the TimerBar doesn't shift sideways as the user
         navigates between sections (Calendar → Reports → Projects …). -->
    <Text
      fontWeight="700"
      fontSize="1.25rem"
      width="120px">
      {pageTitle || pageTitleFromPath(window.location.pathname)}
    </Text>
    <!-- TimerBar lives in the AppHeader so it stays mounted across navigations —
         that's what keeps the running stopwatch ticking when the user jumps to
         Reports/Manage and back. Only the mobile layout uses the compact
         TimerBar docked inside Timesheet. -->
    <TimerBar when="{!appVp.value || !appVp.value.isMobile}"
      projects="{appProjectsDs.value || []}"
      clients="{appClientsDs.value || []}"
      tags="{appTagsDs.value || []}"
      onSaved="() => entriesTick = entriesTick + 1"
    />
  </AppHeader>

  <NavPanel when="{localUser.value && localUser.value.kind === 'ready'}">
    <property name="footerTemplate">
      <Stack width="100%">
      <Theme
        textColor-Button-secondary-ghost="$textColor-NavLink"
        textColor-Button-secondary-ghost--hover="$textColor-NavLink--hover"
        backgroundColor-Button-secondary-ghost--hover="$backgroundColor-NavLink--hover"
      >
      <DropdownMenu alignment="start" width="100%">
        <property name="triggerTemplate">
          <Button
            variant="ghost"
            themeColor="secondary"
            width="100%"
            paddingVertical="$space-1_5"
            paddingHorizontal="$space-3"
            borderRadius="$space-2"
          >
            <HStack verticalAlignment="center" gap="$space-3" width="100%">
              <Stack
                width="28px"
                height="28px"
                borderRadius="999px"
                backgroundColor="$color-surface-200"
                verticalAlignment="center"
                horizontalAlignment="center"
              >
                <Text fontSize="10px" fontWeight="700" color="$color-surface-600">
                  {userInitials(localUser.value && localUser.value.user ? localUser.value.user.name : '')}
                </Text>
              </Stack>
              <Text fontWeight="500" fontSize="14px">
                {localUser.value && localUser.value.user ? localUser.value.user.name : ''}
              </Text>
              <SpaceFiller />
              <Icon name="chevrondown" size="16px" />
            </HStack>
          </Button>
        </property>
        <MenuItem icon="cog" onClick="Actions.navigate('/settings')">
          <Text fontSize="$fontSize-small" fontWeight="600">Settings</Text>
        </MenuItem>
      </DropdownMenu>
      </Theme>
      </Stack>
    </property>

    <NavGroup label="Track" initiallyExpanded="true">
      <NavLink to="/" label="Calendar" icon="date" />
      <NavLink to="/list" label="List" icon="board" />
    </NavGroup>

    <NavGroup label="Analyze" initiallyExpanded="true">
      <NavLink to="/reports" label="Reports" icon="trending_up" />
    </NavGroup>

    <NavGroup label="Manage" initiallyExpanded="true">
      <NavLink to="/projects" label="Projects" icon="folder" />
      <NavLink to="/clients" label="Clients" icon="users" />
      <NavLink to="/tags" label="Tags" icon="hash" />
      <NavLink to="/import" label="Import" icon="upload" />
    </NavGroup>
  </NavPanel>

  <Pages when="{localUser.value && localUser.value.kind === 'ready'}">
    <Page url="/login">
      <Redirect to="/" />
    </Page>
    <Page url="/register">
      <Redirect to="/" />
    </Page>
    <Page url="/">
      <Timesheet view="calendar" />
    </Page>
    <Page url="/list">
      <Timesheet view="list" />
    </Page>
    <Page url="/projects">
      <ProjectsScreen />
    </Page>
    <Page url="/clients">
      <ClientsScreen />
    </Page>
    <Page url="/tags">
      <TagsScreen />
    </Page>
    <Page url="/import">
      <ImportScreen />
    </Page>
    <Page url="/reports">
      <ReportsScreen
        userName="{localUser.value && localUser.value.user ? localUser.value.user.name : ''}"
      />
    </Page>
    <Page url="/settings">
      <SettingsScreen
        userName="{localUser.value && localUser.value.user ? localUser.value.user.name : ''}"
        username="{localUser.value && localUser.value.user ? localUser.value.user.username : ''}"
        theme="{localUser.value && localUser.value.user && localUser.value.user.preferences ? localUser.value.user.preferences.theme : 'system'}"
        onSaveProfile="(p) => localUser.updateUser({ name: p.name, username: p.username })"
        onSaveTheme="(theme) => { tone.setTone(theme); localUser.updateUser({ preferences: { theme: theme } }); }"
      />
    </Page>
  </Pages>
</App>
