<App
  layout="vertical-sticky"
  scrollWholePage="true"
  global.apiBase="{window.__ANIMO_API_BASE__ || 'http://127.0.0.1:8080/api'}"
  global.pageTitle="{pageTitleFromPath(window.location.pathname)}"
  global.entriesTick="{0}"
  onDidNavigate="(to) => pageTitle = pageTitleFromPath(to)"
>
  <Viewport id="appVp" />

  <DataSource
    id="appProjectsDs"
    url="{apiBase + '/projects'}"
    credentials="include"
  />
  <DataSource
    id="appClientsDs"
    url="{apiBase + '/clients'}"
    credentials="include"
  />
  <DataSource
    id="appTagsDs"
    url="{apiBase + '/tags'}"
    credentials="include"
  />
  <TonePersist />

  <AppHeader>
    <!-- Fixed width so the TimerBar doesn't shift sideways as the user
         navigates between sections (Calendar → Reports → Projects …). -->
    <Text
      fontWeight="700"
      fontSize="1.25rem"
      width="120px">
      {pageTitle || pageTitleFromPath(window.location.pathname)}
    </Text>
    <!-- TimerBar lives in the AppHeader so it stays mounted across navigations —
         that's what keeps the running stopwatch ticking when the user jumps to
         Reports/Manage and back. Only the mobile layout uses the compact
         TimerBar docked inside Timesheet. -->
    <TimerBar when="{!appVp.value || !appVp.value.isMobile}"
      projects="{appProjectsDs.value || []}"
      clients="{appClientsDs.value || []}"
      tags="{appTagsDs.value || []}"
      onSaved="() => entriesTick = entriesTick + 1"
    />
  </AppHeader>

  <NavPanel>
    <property name="footerTemplate">
      <Stack width="100%">
      <Theme
        textColor-Button-secondary-ghost="$textColor-NavLink"
        textColor-Button-secondary-ghost--hover="$textColor-NavLink--hover"
        backgroundColor-Button-secondary-ghost--hover="$backgroundColor-NavLink--hover"
      >
      <DropdownMenu alignment="start" width="100%">
        <property name="triggerTemplate">
          <Button
            variant="ghost"
            themeColor="secondary"
            width="100%"
            paddingVertical="$space-1_5"
            paddingHorizontal="$space-3"
            borderRadius="$space-2"
          >
            <HStack verticalAlignment="center" gap="$space-3" width="100%">
              <Stack
                width="28px"
                height="28px"
                borderRadius="999px"
                backgroundColor="$color-surface-200"
                verticalAlignment="center"
                horizontalAlignment="center"
              >
                <Text fontSize="10px" fontWeight="700" color="$color-surface-600">
                  {userInitials('Local User')}
                </Text>
              </Stack>
              <Text fontWeight="500" fontSize="14px">
                Local User
              </Text>
              <SpaceFiller />
              <Icon name="chevrondown" size="16px" />
            </HStack>
          </Button>
        </property>
        <MenuItem icon="cog" onClick="Actions.navigate('/settings')">
          <Text fontSize="$fontSize-small" fontWeight="600">Settings</Text>
        </MenuItem>
      </DropdownMenu>
      </Theme>
      </Stack>
    </property>

    <NavGroup label="Track" initiallyExpanded="true">
      <NavLink to="/" label="Calendar" icon="date" />
      <NavLink to="/list" label="List" icon="board" />
    </NavGroup>

    <NavGroup label="Analyze" initiallyExpanded="true">
      <NavLink to="/reports" label="Reports" icon="trending_up" />
    </NavGroup>

    <NavGroup label="Manage" initiallyExpanded="true">
      <NavLink to="/projects" label="Projects" icon="folder" />
      <NavLink to="/clients" label="Clients" icon="users" />
      <NavLink to="/tags" label="Tags" icon="hash" />
    </NavGroup>
  </NavPanel>

  <Pages>
    <Page url="/login">
      <Redirect to="/" />
    </Page>
    <Page url="/register">
      <Redirect to="/" />
    </Page>
    <Page url="/">
      <Timesheet view="calendar" />
    </Page>
    <Page url="/list">
      <Timesheet view="list" />
    </Page>
    <Page url="/projects">
      <ProjectsScreen />
    </Page>
    <Page url="/clients">
      <ClientsScreen />
    </Page>
    <Page url="/tags">
      <TagsScreen />
    </Page>
    <Page url="/reports">
      <ReportsScreen />
    </Page>
    <Page url="/settings">
      <SettingsScreen />
    </Page>
  </Pages>
</App>
