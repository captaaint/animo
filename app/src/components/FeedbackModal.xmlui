<Component name="FeedbackModal"
  var.category="{'bug'}"
  var.titleInput="{''}"
  var.bodyInput="{''}"
  var.diagnosticsOptIn="{false}"
  var.submitting="{false}"
  var.successIssueUrl="{''}"
  var.errorMessage="{''}"
  var.modalOpen="{false}"
  var.titleError="{!titleInput.trim() ? 'Title is required' : (titleInput.length > 120 ? 'Title must be 120 characters or less' : '')}"
  var.bodyError="{!bodyInput.trim() ? 'Description is required' : (bodyInput.length > 8000 ? 'Description must be 8000 characters or less' : '')}"
  var.canSubmit="{!submitting && !successIssueUrl && !titleError && !bodyError}"
  method.saveDraft="() => {
    if (!window.animoFeedbackSaveDraft) return;
    window.animoFeedbackSaveDraft({
      category: category,
      title: titleInput,
      body: bodyInput,
      diagnostics_opt_in: diagnosticsOptIn
    });
  }"
  method.open="() => {
    const draft = window.animoFeedbackLoadDraft ? window.animoFeedbackLoadDraft() : null;
    const wantsDiagnostics = !!(draft && draft.diagnostics_opt_in);
    category = draft && draft.category ? draft.category : 'bug';
    titleInput = draft && draft.title ? draft.title : '';
    bodyInput = draft && draft.body ? draft.body : '';
    diagnosticsOptIn = wantsDiagnostics;
    submitting = false;
    successIssueUrl = '';
    errorMessage = '';
    modalOpen = true;
    modal.open();
  }"
>
  <Viewport id="vp" />
  <ModalDialog id="modal"
    paddingTop="$space-6"
    maxWidth="{vp.value && vp.value.isMobile ? '460px' : '760px'}"
    padding="$space-4"
    borderRadius="16px"
    closeButtonVisible="true"
    onClose="() => {
      const hasContent = titleInput.trim() || bodyInput.trim();
      if (successIssueUrl || !hasContent) {
        modalOpen = false;
        emitEvent('closed');
        return;
      }
      const shouldClose = confirm(
        'Close feedback?',
        'Your feedback has not been sent yet. Are you sure you want to close this form?',
        'Close',
        'Keep editing'
      );
      if (!shouldClose) {
        return false;
      }
      modalOpen = false;
      emitEvent('closed');
    }">
    <VStack gap="$space-4" width="100%">

      <HStack when="{!successIssueUrl}" gap="$space-3" verticalAlignment="center" width="100%">
        <Stack
          width="48px"
          height="48px"
          borderRadius="14px"
          backgroundColor="$color-primary-100"
          horizontalAlignment="center"
          verticalAlignment="center"
        >
          <Icon name="message-heart" size="md" color="$color-primary-600" />
        </Stack>
        <VStack gap="$space-1" width="*">
          <Text fontSize="$fontSize-2xl" fontWeight="700" color="$color-surface-900">
            Send feedback
          </Text>
          <Text variant="secondary" fontSize="$fontSize-small">
            Tell us what happened, what you expected, or what would help.
          </Text>
        </VStack>
      </HStack>

      <VStack when="{!successIssueUrl}" gap="$space-3" width="100%">
       <Stack
         orientation="{vp.value && vp.value.isMobile ? 'vertical' : 'horizontal'}"
         gap="$space-4"
         width="100%"
         verticalAlignment="start"
       >
        <Card width="*" padding="$space-4" boxShadow="0 2px 8px rgba(0,0,0,0.06)">
          <VStack width="100%" gap="$space-3">
        <VStack gap="$space-2" width="100%">
          <Text fontWeight="500" color="$color-surface-900">Category</Text>
          <Select
            width="100%"
            initialValue="{category}"
            onDidChange="(v) => { category = v || 'bug'; saveDraft(); }"
          >
            <Option value="bug" label="Bug" />
            <Option value="feature" label="Feature request" />
            <Option value="question" label="Question" />
          </Select>
        </VStack>

        <VStack gap="$space-2" width="100%">
          <TextBox
            label="Title"
            required="true"
            maxLength="120"
            initialValue="{titleInput}"
            onDidChange="(v) => { titleInput = v || ''; saveDraft(); }"
          />
          <HStack width="100%">
            <Text
              when="{titleError && titleInput.length > 0}"
              color="$color-danger-600"
              fontSize="$fontSize-small"
            >
              {titleError}
            </Text>
            <SpaceFiller />
            <Text fontSize="$fontSize-xs" variant="secondary">{titleInput.length} / 120</Text>
          </HStack>
        </VStack>

        <VStack gap="$space-2" width="100%">
          <Text fontWeight="500" color="$color-surface-900">Description</Text>
          <TextArea
            width="100%"
            rows="8"
            maxLength="8000"
            resize="vertical"
            initialValue="{bodyInput}"
            onDidChange="(v) => { bodyInput = v || ''; saveDraft(); }"
            placeholder="What happened, what did you expect, or what would you like to see?"
          />
          <HStack width="100%">
            <Text
              when="{bodyError && bodyInput.length > 0}"
              color="$color-danger-600"
              fontSize="$fontSize-small"
            >
              {bodyError}
            </Text>
            <SpaceFiller />
            <Text fontSize="$fontSize-xs" variant="secondary">{bodyInput.length} / 8000</Text>
          </HStack>
        </VStack>
          </VStack>
        </Card>

        <VStack width="*" gap="$space-3">
        <Card padding="$space-4" boxShadow="0 2px 8px rgba(0,0,0,0.06)">
          <HStack gap="$space-3" verticalAlignment="center" width="100%">
            <Stack
              width="40px"
              height="40px"
              borderRadius="10px"
              backgroundColor="$color-primary-100"
              horizontalAlignment="center"
              verticalAlignment="center"
            >
              <Icon name="file-text" color="$color-primary-600" />
            </Stack>
            <VStack width="*" gap="$space-1">
              <Text fontWeight="500" color="$color-surface-900">Attach diagnostics</Text>
              <Text fontSize="$fontSize-xs" variant="secondary">
                Preview exactly what will be attached before sending.
              </Text>
            </VStack>
            <Switch
              initialValue="{diagnosticsOptIn}"
              onDidChange="(v) => {
                diagnosticsOptIn = !!v;
                saveDraft();
              }"
            />
          </HStack>
        </Card>

        <Card
          when="{diagnosticsOptIn}"
          padding="$space-4"
          boxShadow="0 2px 8px rgba(0,0,0,0.06)"
        >
          <VStack gap="$space-2" width="100%">
            <Text fontWeight="600" fontSize="$fontSize-small">Diagnostics preview</Text>
            <TextArea
              width="100%"
              rows="8"
              readOnly="true"
              fontFamily="monospace"
              fontSize="$fontSize-xs"
              initialValue="{window.animoFeedbackBuildPreview ? window.animoFeedbackBuildPreview({ category: category, title: titleInput, body: bodyInput, diagnostics_opt_in: true }) : 'Diagnostics preview is unavailable.'}"
            />
          </VStack>
        </Card>

        <Card padding="$space-4" boxShadow="0 2px 8px rgba(0,0,0,0.06)" backgroundColor="$color-primary-50">
          <HStack gap="$space-2" verticalAlignment="center" width="100%">
            <Icon name="info" color="$color-primary-600" />
            <Text fontSize="$fontSize-xs" variant="secondary" width="*">
              Your feedback is completely anonymous — no personal data is included in what you send.
            </Text>
          </HStack>
        </Card>
        </VStack>
       </Stack>

        <Text
          when="{errorMessage}"
          color="$color-danger-600"
          fontSize="$fontSize-small"
        >
          {errorMessage}
        </Text>
      </VStack>

      <VStack
        when="{successIssueUrl}"
        gap="$space-5"
        width="100%"
        horizontalAlignment="center"
        paddingVertical="$space-6"
      >
        <Image
          src="resource:feedback-success"
          alt="Feedback sent"
          width="120px"
          height="120px"
          fit="contain"
        />

        <VStack gap="$space-1" width="100%" horizontalAlignment="center">
          <Text
            fontSize="$fontSize-2xl"
            fontWeight="700"
            color="$color-success-700"
            textAlign="center"
          >
            Feedback sent
          </Text>
          <Text color="$color-surface-500" textAlign="center">
            Thanks — your issue was created successfully.
          </Text>
        </VStack>
      </VStack>

      <HStack width="100%" verticalAlignment="center" gap="$space-3">
        <Button
          when="{!successIssueUrl}"
          label="Cancel"
          variant="outlined"
          themeColor="secondary"
          enabled="{!submitting}"
          onClick="modal.close()"
        />
        <SpaceFiller />
        <Button
          when="{successIssueUrl}"
          label="Done"
          themeColor="primary"
          onClick="modal.close()"
        />
        <Button
          when="{!successIssueUrl}"
          label="{submitting ? 'Sending...' : 'Send feedback'}"
          themeColor="primary"
          enabled="{canSubmit}"
          onClick="() => {
            if (!canSubmit || !window.animoFeedbackSubmit) return;
            submitting = true;
            errorMessage = '';
            window.animoFeedbackSubmit(
              {
                category: category,
                title: titleInput,
                body: bodyInput,
                diagnostics_opt_in: diagnosticsOptIn
              },
              (result) => {
                submitting = false;
                if (result && result.ok) {
                  successIssueUrl = result.issue_url || '';
                  if (window.animoFeedbackClearDraft) window.animoFeedbackClearDraft();
                  toast.success('Feedback sent');
                  return;
                }
                errorMessage = result && result.error ? result.error : 'Failed to send feedback';
              },
              (message) => {
                submitting = false;
                errorMessage = message || 'Failed to send feedback';
              }
            );
          }"
        />
      </HStack>
    </VStack>
  </ModalDialog>
</Component>
