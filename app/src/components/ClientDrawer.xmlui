<Component name="ClientDrawer"
  var.editItem="{null}"
  var.nameInput="{''}"
  var.colorInput="{'#3F8F8C'}"
  var.colorPalette="{[
    { hex: '#3F8F8C', name: 'Sage teal' },
    { hex: '#5BA84B', name: 'Forest green' },
    { hex: '#A7C957', name: 'Lime' },
    { hex: '#6FCF97', name: 'Mint' },
    { hex: '#F2C94C', name: 'Amber' },
    { hex: '#F2994A', name: 'Orange' },
    { hex: '#EB5757', name: 'Coral' },
    { hex: '#EB5C9D', name: 'Magenta' },
    { hex: '#9B51E0', name: 'Purple' },
    { hex: '#3F51B5', name: 'Indigo' },
    { hex: '#2D9CDB', name: 'Sky blue' },
    { hex: '#56CCF2', name: 'Light blue' },
    { hex: '#4A6172', name: 'Slate' },
    { hex: '#BDBDBD', name: 'Gray' },
    { hex: '#8B5E3C', name: 'Brown' },
    { hex: '#C77878', name: 'Dusty rose' }
  ]}"
  var.drawerOpen="{false}"
  method.open="(data) => {
    editItem = data || null;
    nameInput = data ? data.name : '';
    colorInput = data ? data.color : '#3F8F8C';
    drawerOpen = true;
  }"
>
  <APICall id="saveCall"
    method="{editItem ? 'patch' : 'post'}"
    url="{editItem ? apiBase + '/clients/' + editItem.id : apiBase + '/clients'}"
    credentials="include"
    body="{{ name: nameInput, color: colorInput }}"
    onSuccess="() => {
      toast.success(editItem ? 'Client updated' : 'Client added');
      emitEvent('saved');
      drawerOpen = false;
      emitEvent('closed');
    }"
    onError="() => toast.error('Save failed')"
  />

  <Drawer
    when="{drawerOpen}"
    initiallyOpen="true"
    position="bottom"
    closeButtonVisible="false"
    onClose="() => { drawerOpen = false; emitEvent('closed'); }">
    <property name="headerTemplate">
      <HStack width="100%" verticalAlignment="center">
        <Button
          icon="close"
          type="button"
          variant="outlined"
          themeColor="secondary"
          width="48px"
          height="48px"
          borderRadius="50%"
          borderColor="$color-surface-400"
          borderWidth="1px"
          onClick="drawerOpen = false; emitEvent('closed')"
        />
        <SpaceFiller />
        <Text fontSize="$fontSize-large" fontWeight="700" color="$color-surface-900">
          {editItem ? 'Edit client' : 'New client'}
        </Text>
        <SpaceFiller />
        <Button
          icon="checkmark"
          themeColor="primary"
          width="48px"
          height="48px"
          borderRadius="50%"
          onClick="if (!nameInput || nameInput.trim().length === 0) { toast.error('Name is required'); return; } saveCall.execute();"
        />
      </HStack>
    </property>

    <VStack width="100%" gap="$space-3">
      <Card padding="$space-4">
        <VStack gap="$space-2" width="100%">
          <Text fontWeight="700" fontSize="$fontSize-medium" color="$color-surface-900">Name</Text>
          <Text variant="secondary" fontSize="$fontSize-small">Choose a name for your client</Text>
          <TextBox
            width="100%"
            initialValue="{nameInput}"
            onDidChange="(v) => nameInput = v || ''"
          />
        </VStack>
      </Card>

      <Card padding="$space-4">
        <VStack gap="$space-3" width="100%">
          <VStack gap="$space-1" width="100%">
            <Text fontWeight="700" fontSize="$fontSize-medium" color="$color-surface-900">Color</Text>
            <Text variant="secondary" fontSize="$fontSize-small">Choose a color to identify your client</Text>
          </VStack>

          <Card padding="$space-3"
            backgroundColor="$color-surface-50"
            border="1px solid $color-surface-200">
            <HStack verticalAlignment="center" gap="$space-3" width="100%">
              <Stack width="40px" height="40px" borderRadius="8px"
                backgroundColor="{colorInput}" />
              <VStack gap="0">
                <Text fontWeight="600" color="$color-surface-900">
                  {(colorPalette.find(c => c.hex === colorInput) || { name: 'Custom' }).name}
                </Text>
                <Text variant="secondary" fontSize="$fontSize-small">{colorInput}</Text>
              </VStack>
              <SpaceFiller />
              <Stack width="28px" height="28px" borderRadius="50%"
                backgroundColor="$color-primary-500"
                verticalAlignment="center" horizontalAlignment="center">
                <Icon name="checkmark" color="white" size="sm" />
              </Stack>
            </HStack>
          </Card>

          <VStack gap="$space-2" width="100%">
            <HStack gap="$space-2" width="100%">
              <Items data="{colorPalette.slice(0, 8)}">
                <Stack
                  width="*"
                  height="40px"
                  borderRadius="10px"
                  backgroundColor="{$item.hex}"
                  cursor="pointer"
                  verticalAlignment="center"
                  horizontalAlignment="center"
                  onClick="colorInput = $item.hex">
                  <Stack
                    when="{colorInput === $item.hex}"
                    width="22px"
                    height="22px"
                    borderRadius="50%"
                    backgroundColor="white"
                    verticalAlignment="center" horizontalAlignment="center">
                    <Icon name="checkmark" color="{$item.hex}" size="sm" />
                  </Stack>
                </Stack>
              </Items>
            </HStack>
            <HStack gap="$space-2" width="100%">
              <Items data="{colorPalette.slice(8)}">
                <Stack
                  width="*"
                  height="40px"
                  borderRadius="10px"
                  backgroundColor="{$item.hex}"
                  cursor="pointer"
                  verticalAlignment="center"
                  horizontalAlignment="center"
                  onClick="colorInput = $item.hex">
                  <Stack
                    when="{colorInput === $item.hex}"
                    width="22px"
                    height="22px"
                    borderRadius="50%"
                    backgroundColor="white"
                    verticalAlignment="center" horizontalAlignment="center">
                    <Icon name="checkmark" color="{$item.hex}" size="sm" />
                  </Stack>
                </Stack>
              </Items>
            </HStack>
          </VStack>
        </VStack>
      </Card>

      <Theme
        when="{!!editItem}"
        textColor-Button-attention-outlined="$color-danger-500"
        borderColor-Button-attention-outlined="$color-danger-500">
        <Button
          type="button"
          width="100%"
          icon="trash"
          label="Delete"
          variant="outlined"
          themeColor="attention"
          onClick="const item = editItem; drawerOpen = false; emitEvent('deleteRequested', item);"
        />
      </Theme>
    </VStack>
  </Drawer>
</Component>
