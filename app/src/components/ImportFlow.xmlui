<Component name="ImportFlow"
  var.step="{'select'}"
  var.fileName="{''}"
  var.isXlsx="{false}"
  var.formatHint="{'auto'}"
  var.previewData="{null}"
  var.summaryData="{null}"
  var.errorMessage="{null}"
  var.commitError="{null}"
>
  <!--
    CSV/XLSX import. The page only ever shows the `select` card (file +
    format). Previewing opens an overlay that walks the remaining steps
    (loading → preview → summary): a ModalDialog on desktop, a bottom Drawer
    on mobile (the same split the Entry/DeleteConfirm screens use). Only one
    is mounted at a time, gated on `vp.value.isMobile`.

    The step markup is inlined in BOTH overlays on purpose. It reads the
    component-scope vars (`step`, `previewData`, …) directly so it stays
    reactive; passing this state down into a shared child component left the
    child rendering its mount-time snapshot (empty drawer on mobile).

    `onClose` on each overlay resets the in-overlay state, so any close path
    (X, Esc, backdrop, Cancel) lands back on the select card.

    Two separate error vars on purpose:
      • `errorMessage` — page-level (preview request failed); shown under the
        select card after the overlay closes.
      • `commitError`  — in-overlay (commit request failed); shown on the
        preview view while the overlay stays open. Cleared by `onClose`.

    Important: we never store the raw `File` object in a var. XMLUI's XS
    layer doesn't reliably round-trip DOM `File` instances through `var.*`
    state — by the time you read it back, the `name` property is gone and
    `file.name.toLowerCase()` blows up. Instead we keep just the metadata
    we need (`fileName`, `isXlsx`) and re-read `importDrop.value[0]` at
    the click moment when the actual File reference is required.

    `previewData` / `summaryData` come straight from importApi.ts —
    field names already match the backend's camelCase responses.
  -->

  <Viewport id="vp" />

  <!-- ───────────────── Page: select card ───────────────── -->
  <VStack gap="$space-4">
    <Text>
      Import time entries from CSV or XLSX. Supports Animo exports plus
      Toggl, Clockify, and Harvest Detailed reports (per-entry
      timestamps required — Summary reports are not supported).
      Duplicate rows (same date, time range, and description) are
      skipped automatically; new clients, projects, and tags are
      created as needed.
    </Text>

    <FileUploadDropZone
      id="importDrop"
      testId="import-dropzone"
      text="Drop your file here"
      icon="file-text"
      onUpload="(files) => {
        // Accept any file here (react-dropzone only sees MIME types during a
        // drag, not extensions, so an extension-based `acceptedFileTypes`
        // would silently reject .csv/.xlsx and kill the drop). Validate by
        // extension instead; the backend re-validates the format anyway.
        const f = files && files[0] ? files[0] : null;
        const name = f && f.name ? f.name : '';
        const lower = name.toLowerCase();
        if (name && !lower.endsWith('.csv') && !lower.endsWith('.xlsx')) {
          fileName = '';
          isXlsx = false;
          errorMessage = 'Please choose a .csv or .xlsx file.';
          return;
        }
        fileName = name;
        isXlsx = lower.endsWith('.xlsx');
        errorMessage = null;
      }"
    >
      <VStack
        width="100%"
        paddingVertical="$space-8"
        paddingHorizontal="$space-4"
        horizontalAlignment="center"
        verticalAlignment="center"
        gap="$space-3"
      >
        <Stack
          width="56px"
          height="56px"
          borderRadius="50%"
          backgroundColor="$color-primary-100"
          horizontalAlignment="center"
          verticalAlignment="center"
        >
          <Icon name="file-text" size="lg" color="$color-primary-500" />
        </Stack>
        <VStack gap="$space-1" horizontalAlignment="center">
          <Text fontWeight="700" fontSize="1.125rem">
            {fileName ? fileName : 'Drag and drop your file here'}
          </Text>
          <Text variant="secondary" fontSize="$fontSize-small">
            {fileName ? 'Drop another file, or choose to replace' : 'or click to browse'}
          </Text>
        </VStack>
        <Button label="Choose file" themeColor="primary" variant="outlined" onClick="importDrop.open()" />
      </VStack>
    </FileUploadDropZone>

    <HStack gap="$space-3" verticalAlignment="center">
      <Text fontWeight="600">Format</Text>
      <Select
        width="*"
        maxWidth="360px"
        initialValue="{formatHint}"
        onDidChange="(v) => formatHint = v"
      >
        <Option value="auto" label="Auto-detect" />
        <Option value="animo" label="Animo" />
        <Option value="toggl" label="Toggl" />
        <Option value="clockify" label="Clockify" />
        <Option value="harvest" label="Harvest" />
      </Select>
    </HStack>

    <Card backgroundColor="$color-primary-50" border="0" padding="$space-3">
      <HStack gap="$space-3" verticalAlignment="start">
        <Icon name="info" color="$color-primary-600" />
        <VStack gap="$space-0_5">
          <Text fontWeight="700" color="$color-primary-700" fontSize="$fontSize-small">
            Supported formats
          </Text>
          <Text variant="secondary" fontSize="$fontSize-small">
            CSV (.csv) and Excel (.xlsx)
          </Text>
        </VStack>
      </HStack>
    </Card>

    <Text
      when="{errorMessage}"
      color="$color-danger-600"
      fontSize="$fontSize-small"
    >
      {errorMessage}
    </Text>

    <!-- Primary CTA: previewing is how the whole import flow starts, so it
         carries the page's main emphasis. -->
    <Button
      label="Preview import"
      themeColor="primary"
      icon="eye"
      size="lg"
      enabled="{fileName.length > 0}"
      onClick="() => {
        // Read the real File object out of the drop zone at click time —
        // never from a cached var (see header comment).
        const liveFile = importDrop.value && importDrop.value[0];
        if (!liveFile || !liveFile.name) {
          errorMessage = 'No file selected';
          return;
        }
        errorMessage = null;
        commitError = null;
        // Setting step opens the right overlay reactively (its `when`
        // includes `step !== 'select'`); no imperative open()/close() needed.
        step = 'loading';
        window.animoImportPreview(
          liveFile,
          formatHint,
          (data) => { previewData = data; step = 'preview'; },
          (msg) => { errorMessage = msg; step = 'select'; }
        );
      }"
    />
  </VStack>

  <!-- ───────────────── Desktop: modal ───────────────── -->
  <!-- Theme override keeps the title in line with the app's other modals
       (EntryModal, ProjectModal, …): $fontSize-large / weight 600 instead of
       the ModalDialog default 2xl. -->
  <Theme
    fontSize-title-ModalDialog="$fontSize-large"
    fontWeight-title-ModalDialog="600"
  >
  <ModalDialog
    id="importModal"
    when="{(!vp.value || !vp.value.isMobile) && step !== 'select'}"
    maxWidth="720px"
    padding="$space-4"
    borderRadius="16px"
    title="{step === 'summary' ? 'Import complete' : 'Preview import'}"
    onClose="() => {
      step = 'select';
      previewData = null;
      summaryData = null;
      commitError = null;
    }"
  >
    <Fragment when="{step === 'loading'}">
      <VStack horizontalAlignment="center" verticalAlignment="center" gap="$space-3" paddingVertical="$space-6">
        <Spinner />
        <Text>Working…</Text>
      </VStack>
    </Fragment>

    <Fragment when="{step === 'preview' && previewData}">
      <VStack gap="$space-4">
        <!-- File info -->
        <HStack gap="$space-3" verticalAlignment="center">
          <Stack
            width="44px" height="44px" borderRadius="50%"
            backgroundColor="$color-primary-50"
            horizontalAlignment="center" verticalAlignment="center"
          >
            <Icon name="file-text" color="$color-primary-500" />
          </Stack>
          <VStack gap="$space-0_5">
            <HStack gap="$space-2" verticalAlignment="center">
              <Text variant="secondary" fontSize="$fontSize-small">Detected format:</Text>
              <Text fontWeight="700" color="$color-primary-600" fontSize="$fontSize-small">{previewData.format}</Text>
            </HStack>
            <HStack gap="$space-2" verticalAlignment="center">
              <Text variant="secondary" fontSize="$fontSize-small">File name:</Text>
              <Text fontWeight="700" color="$color-primary-600" fontSize="$fontSize-small">{fileName}</Text>
            </HStack>
          </VStack>
        </HStack>

        <!-- KPI cards -->
        <HStack gap="$space-3" wrapContent="true">
          <Card padding="$space-3" width="*" minWidth="150px">
            <HStack gap="$space-3" verticalAlignment="center">
              <Stack width="36px" height="36px" borderRadius="50%" backgroundColor="$color-surface-100"
                     horizontalAlignment="center" verticalAlignment="center">
                <Icon name="database" color="$color-surface-600" />
              </Stack>
              <VStack gap="$space-0_5">
                <Text variant="secondary" fontSize="$fontSize-xs" fontWeight="600">Total rows</Text>
                <Text fontWeight="700" fontSize="1.25rem">{previewData.totalRows}</Text>
              </VStack>
            </HStack>
          </Card>
          <Card padding="$space-3" width="*" minWidth="150px"
                backgroundColor="$color-primary-50" border="1px solid $color-primary-200">
            <HStack gap="$space-3" verticalAlignment="center">
              <Stack width="36px" height="36px" borderRadius="50%" backgroundColor="$color-primary-100"
                     horizontalAlignment="center" verticalAlignment="center">
                <Icon name="checkmark" color="$color-primary-600" />
              </Stack>
              <VStack gap="$space-0_5">
                <Text variant="secondary" fontSize="$fontSize-xs" fontWeight="600">Will import</Text>
                <Text fontWeight="700" fontSize="1.25rem" color="$color-primary-600">{previewData.validRows}</Text>
              </VStack>
            </HStack>
          </Card>
          <Card padding="$space-3" width="*" minWidth="150px">
            <HStack gap="$space-3" verticalAlignment="center">
              <Stack width="36px" height="36px" borderRadius="50%" backgroundColor="$color-surface-100"
                     horizontalAlignment="center" verticalAlignment="center">
                <Icon name="copy" color="$color-surface-600" />
              </Stack>
              <VStack gap="$space-0_5">
                <Text variant="secondary" fontSize="$fontSize-xs" fontWeight="600">Duplicates</Text>
                <Text fontWeight="700" fontSize="1.25rem">{previewData.duplicateWarnings}</Text>
              </VStack>
            </HStack>
          </Card>
          <Card padding="$space-3" width="*" minWidth="150px">
            <HStack gap="$space-3" verticalAlignment="center">
              <Stack width="36px" height="36px" borderRadius="50%" backgroundColor="$color-surface-100"
                     horizontalAlignment="center" verticalAlignment="center">
                <Icon name="warning" color="{previewData.errorRows.length > 0 ? '$color-danger-500' : '$color-surface-600'}" />
              </Stack>
              <VStack gap="$space-0_5">
                <Text variant="secondary" fontSize="$fontSize-xs" fontWeight="600">Errors</Text>
                <Text fontWeight="700" fontSize="1.25rem"
                  color="{previewData.errorRows.length > 0 ? '$color-danger-600' : '$color-surface-900'}">
                  {previewData.errorRows.length}
                </Text>
              </VStack>
            </HStack>
          </Card>
        </HStack>

        <VStack when="{previewData.errorRows.length > 0}" gap="$space-2">
          <Text fontWeight="600">Rows with problems:</Text>
          <Table data="{previewData.errorRows}">
            <Column bindTo="row" header="Row" width="80px" />
            <Column bindTo="message" header="Reason" width="*" />
          </Table>
        </VStack>

        <Text when="{commitError}" color="$color-danger-600" fontSize="$fontSize-small">{commitError}</Text>

        <!-- Footer -->
        <HStack
          gap="$space-2"
          verticalAlignment="center"
          paddingTop="$space-3"
          borderTop="1px solid $color-surface-200"
        >
          <SpaceFiller />
          <Button label="Cancel" variant="ghost" onClick="step = 'select'; previewData = null; summaryData = null; commitError = null;" />
          <Button
            label="Import {previewData.validRows} entries"
            themeColor="primary"
            enabled="{previewData.validRows > 0}"
            onClick="() => {
              step = 'loading';
              commitError = null;
              window.animoImportCommit(
                previewData.sessionId,
                isXlsx,
                (data) => { summaryData = data; step = 'summary'; },
                (msg) => { commitError = msg; step = 'preview'; }
              );
            }"
          />
        </HStack>
      </VStack>
    </Fragment>

    <Fragment when="{step === 'summary' && summaryData}">
      <VStack gap="$space-2">
        <HStack gap="$space-2" verticalAlignment="center">
          <Icon name="check" color="$color-primary-600" />
          <Text fontWeight="600">Import complete</Text>
        </HStack>
        <Text>{summaryData.entriesCreated} {summaryData.entriesCreated === 1 ? 'entry' : 'entries'} created.</Text>
        <Text variant="secondary" fontSize="$fontSize-small">
          Created {summaryData.clientsCreated} client(s), {summaryData.projectsCreated} project(s),
          {summaryData.tagsCreated} tag(s). Skipped {summaryData.duplicatesSkipped} duplicate(s).
        </Text>
        <HStack gap="$space-2">
          <Button
            label="Import another file"
            themeColor="primary"
            onClick="fileName = ''; isXlsx = false; step = 'select'; previewData = null; summaryData = null; commitError = null;;"
          />
        </HStack>
      </VStack>
    </Fragment>
  </ModalDialog>
  </Theme>

  <!-- ───────────────── Mobile: bottom drawer ───────────────── -->
  <Drawer
    id="importDrawer"
    when="{vp.value && vp.value.isMobile && step !== 'select'}"
    initiallyOpen="true"
    position="bottom"
    closeButtonVisible="true"
    onClose="() => {
      step = 'select';
      previewData = null;
      summaryData = null;
      commitError = null;
    }"
  >
    <property name="headerTemplate">
      <Text fontWeight="700" fontSize="$fontSize-large">
        {step === 'summary' ? 'Import complete' : 'Preview import'}
      </Text>
    </property>

    <Fragment when="{step === 'loading'}">
      <VStack horizontalAlignment="center" verticalAlignment="center" gap="$space-3" paddingVertical="$space-6">
        <Spinner />
        <Text>Working…</Text>
      </VStack>
    </Fragment>

    <Fragment when="{step === 'preview' && previewData}">
      <VStack gap="$space-4">
        <!-- File info -->
        <HStack gap="$space-3" verticalAlignment="center">
          <Stack
            width="44px" height="44px" borderRadius="50%"
            backgroundColor="$color-primary-50"
            horizontalAlignment="center" verticalAlignment="center"
          >
            <Icon name="file-text" color="$color-primary-500" />
          </Stack>
          <VStack gap="$space-0_5">
            <HStack gap="$space-2" verticalAlignment="center">
              <Text variant="secondary" fontSize="$fontSize-small">Detected format:</Text>
              <Text fontWeight="700" color="$color-primary-600" fontSize="$fontSize-small">{previewData.format}</Text>
            </HStack>
            <HStack gap="$space-2" verticalAlignment="center">
              <Text variant="secondary" fontSize="$fontSize-small">File name:</Text>
              <Text fontWeight="700" color="$color-primary-600" fontSize="$fontSize-small">{fileName}</Text>
            </HStack>
          </VStack>
        </HStack>

        <!-- KPI cards -->
        <HStack gap="$space-3" wrapContent="true">
          <Card padding="$space-3" width="*" minWidth="150px">
            <HStack gap="$space-3" verticalAlignment="center">
              <Stack width="36px" height="36px" borderRadius="50%" backgroundColor="$color-surface-100"
                     horizontalAlignment="center" verticalAlignment="center">
                <Icon name="database" color="$color-surface-600" />
              </Stack>
              <VStack gap="$space-0_5">
                <Text variant="secondary" fontSize="$fontSize-xs" fontWeight="600">Total rows</Text>
                <Text fontWeight="700" fontSize="1.25rem">{previewData.totalRows}</Text>
              </VStack>
            </HStack>
          </Card>
          <Card padding="$space-3" width="*" minWidth="150px"
                backgroundColor="$color-primary-50" border="1px solid $color-primary-200">
            <HStack gap="$space-3" verticalAlignment="center">
              <Stack width="36px" height="36px" borderRadius="50%" backgroundColor="$color-primary-100"
                     horizontalAlignment="center" verticalAlignment="center">
                <Icon name="checkmark" color="$color-primary-600" />
              </Stack>
              <VStack gap="$space-0_5">
                <Text variant="secondary" fontSize="$fontSize-xs" fontWeight="600">Will import</Text>
                <Text fontWeight="700" fontSize="1.25rem" color="$color-primary-600">{previewData.validRows}</Text>
              </VStack>
            </HStack>
          </Card>
          <Card padding="$space-3" width="*" minWidth="150px">
            <HStack gap="$space-3" verticalAlignment="center">
              <Stack width="36px" height="36px" borderRadius="50%" backgroundColor="$color-surface-100"
                     horizontalAlignment="center" verticalAlignment="center">
                <Icon name="copy" color="$color-surface-600" />
              </Stack>
              <VStack gap="$space-0_5">
                <Text variant="secondary" fontSize="$fontSize-xs" fontWeight="600">Duplicates</Text>
                <Text fontWeight="700" fontSize="1.25rem">{previewData.duplicateWarnings}</Text>
              </VStack>
            </HStack>
          </Card>
          <Card padding="$space-3" width="*" minWidth="150px">
            <HStack gap="$space-3" verticalAlignment="center">
              <Stack width="36px" height="36px" borderRadius="50%" backgroundColor="$color-surface-100"
                     horizontalAlignment="center" verticalAlignment="center">
                <Icon name="warning" color="{previewData.errorRows.length > 0 ? '$color-danger-500' : '$color-surface-600'}" />
              </Stack>
              <VStack gap="$space-0_5">
                <Text variant="secondary" fontSize="$fontSize-xs" fontWeight="600">Errors</Text>
                <Text fontWeight="700" fontSize="1.25rem"
                  color="{previewData.errorRows.length > 0 ? '$color-danger-600' : '$color-surface-900'}">
                  {previewData.errorRows.length}
                </Text>
              </VStack>
            </HStack>
          </Card>
        </HStack>

        <VStack when="{previewData.errorRows.length > 0}" gap="$space-2">
          <Text fontWeight="600">Rows with problems:</Text>
          <Table data="{previewData.errorRows}">
            <Column bindTo="row" header="Row" width="80px" />
            <Column bindTo="message" header="Reason" width="*" />
          </Table>
        </VStack>

        <Text when="{commitError}" color="$color-danger-600" fontSize="$fontSize-small">{commitError}</Text>

        <!-- Footer -->
        <HStack
          gap="$space-2"
          verticalAlignment="center"
          paddingTop="$space-3"
          borderTop="1px solid $color-surface-200"
        >
          <SpaceFiller />
          <Button label="Cancel" variant="ghost" onClick="step = 'select'; previewData = null; summaryData = null; commitError = null;" />
          <Button
            label="Import {previewData.validRows} entries"
            themeColor="primary"
            enabled="{previewData.validRows > 0}"
            onClick="() => {
              step = 'loading';
              commitError = null;
              window.animoImportCommit(
                previewData.sessionId,
                isXlsx,
                (data) => { summaryData = data; step = 'summary'; },
                (msg) => { commitError = msg; step = 'preview'; }
              );
            }"
          />
        </HStack>
      </VStack>
    </Fragment>

    <Fragment when="{step === 'summary' && summaryData}">
      <VStack gap="$space-2">
        <HStack gap="$space-2" verticalAlignment="center">
          <Icon name="check" color="$color-primary-600" />
          <Text fontWeight="600">Import complete</Text>
        </HStack>
        <Text>{summaryData.entriesCreated} {summaryData.entriesCreated === 1 ? 'entry' : 'entries'} created.</Text>
        <Text variant="secondary" fontSize="$fontSize-small">
          Created {summaryData.clientsCreated} client(s), {summaryData.projectsCreated} project(s),
          {summaryData.tagsCreated} tag(s). Skipped {summaryData.duplicatesSkipped} duplicate(s).
        </Text>
        <HStack gap="$space-2">
          <Button
            label="Import another file"
            themeColor="primary"
            onClick="fileName = ''; isXlsx = false; step = 'select'; previewData = null; summaryData = null; commitError = null;;"
          />
        </HStack>
      </VStack>
    </Fragment>
  </Drawer>
</Component>
