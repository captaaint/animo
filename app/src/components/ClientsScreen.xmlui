<Component name="ClientsScreen">
  <DataSource
    id="clientsDs"
    url="{apiBase + '/clients'}"
    credentials="include"
  />

  <Viewport id="vp" />

  <ClientModal
    when="{!vp.value || !vp.value.isMobile}"
    id="clientModal"
    onSaved="() => clientsDs.refetch()"
    onDeleteRequested="(item) => deleteConfirmModal.open(item.id)"
  />

  <ClientDrawer
    when="{vp.value &amp;&amp; vp.value.isMobile}"
    id="clientDrawer"
    onSaved="() => clientsDs.refetch()"
    onDeleteRequested="(item) => deleteConfirmDrawer.open(item)"
  />

  <DeleteConfirmModal
    when="{!vp.value || !vp.value.isMobile}"
    id="deleteConfirmModal"
    title="Delete client"
    message="Are you sure you want to delete this client? This action cannot be undone."
    onConfirmed="(id) => deleteCall.execute(id)"
  />

  <DeleteConfirmDrawer
    when="{vp.value &amp;&amp; vp.value.isMobile}"
    id="deleteConfirmDrawer"
    title="Delete client"
    confirmText="Delete this client?"
    message="This action cannot be undone."
    onConfirmed="(id) => deleteCall.execute(id)"
  />

  <APICall
    id="deleteCall"
    method="DELETE"
    url="{apiBase + '/clients/' + $param}"
    credentials="include"
    onSuccess="() => { toast.success('Client deleted'); clientsDs.refetch(); }"
    onError="() => toast.error('Delete failed')"
  />

  <VStack
    gap="$space-4"
    padding="0"
    width="100%"
    maxWidth="800px"
    marginHorizontal="auto"
    height="*"
    overflowY="auto"
  >

    <!-- Desktop/tablet: table with combined Client column + Color hex column -->
    <HStack when="{!vp.value || !vp.value.isMobile}" verticalAlignment="center">
      <SpaceFiller />
      <Button
        label="New client"
        icon="plus"
        onClick="clientModal.open()"
      />
    </HStack>

    <Card when="{!vp.value || !vp.value.isMobile}" padding="$space-4" borderRadius="16px">
      <Table
        data="{clientsDs.value || []}"
        when="{(clientsDs.value || []).length > 0}"
      >
        <Column header="Client">
          <HStack verticalAlignment="center" gap="$space-2">
            <Text>
              {$item.name}
            </Text>
          </HStack>
        </Column>
        <Column header="Color" width="160px">
          <HStack verticalAlignment="center" gap="$space-2">
            <Stack
              backgroundColor="{$item.color}"
              width="20px"
              height="20px"
              borderRadius="3px"
            />
            <Text variant="secondary">
              {$item.color}
            </Text>
          </HStack>
        </Column>
        <Column header="" width="100px">
          <HStack gap="$space-1" verticalAlignment="center">
            <Button
              icon="pencil"
              size="xs"
              variant="ghost"
              themeColor="secondary"
              padding="$space-2"
              onClick="clientModal.open($item)"
            />
            <Button
              icon="trash"
              size="xs"
              variant="ghost"
              themeColor="attention"
              padding="$space-2"
              onClick="deleteConfirmModal.open($item.id)"
            />
          </HStack>
        </Column>
      </Table>

      <Stack
        when="{clientsDs.loaded && (clientsDs.value || []).length === 0}"
        horizontalAlignment="center"
        verticalAlignment="center"
        minHeight="320px"
        paddingVertical="$space-8"
      >
        <VStack gap="$space-3" horizontalAlignment="center">
          <Image
            src="resource:clients-empty-list"
            alt="No clients yet"
            width="220px"
            height="151px"
            fit="contain"
          />
          <VStack gap="$space-1" horizontalAlignment="center">
            <Text fontSize="1.25rem" fontWeight="700" textAlign="center" color="$textColor-Heading">
              Your first client is waiting
            </Text>
            <Text variant="secondary" fontSize="$fontSize-small" textAlign="center">
              Create a client to group projects and keep reports organized.
            </Text>
          </VStack>
        </VStack>
      </Stack>
      <Spinner when="{!clientsDs.loaded}" />
    </Card>

    <!-- Mobile: flat list rows with three-dot context menu -->
    <VStack when="{vp.value &amp;&amp; vp.value.isMobile}" gap="$space-3">
      <Button
        width="100%"
        label="New client"
        icon="plus"
        onClick="clientDrawer.open()"
      />

      <Card
        when="{(clientsDs.value || []).length > 0}"
        padding="$space-2"
        width="100%"
        borderRadius="16px"
      >
        <Items data="{clientsDs.value || []}">
          <VStack gap="0">
            <HStack
              verticalAlignment="center"
              paddingVertical="$space-3"
              paddingHorizontal="$space-2"
              gap="$space-3"
            >
              <Stack
                backgroundColor="{$item.color}"
                width="16px"
                height="16px"
                borderRadius="3px"
              />
              <Text fontWeight="500">
                {$item.name}
              </Text>
              <SpaceFiller />
              <DropdownMenu alignment="end">
                <property name="triggerTemplate">
                  <Button
                    icon="dotmenu"
                    variant="ghost"
                    size="sm"
                    themeColor="secondary"
                  />
                </property>
                <MenuItem icon="pencil" onClick="clientDrawer.open($item)">
                  Edit
                </MenuItem>
                <MenuSeparator />
                <MenuItem icon="trash" onClick="deleteConfirmDrawer.open($item)">
                  Delete
                </MenuItem>
              </DropdownMenu>
            </HStack>
            <ContentSeparator when="{!$isLast}" />
          </VStack>
        </Items>
      </Card>

      <Card
        when="{clientsDs.loaded && (clientsDs.value || []).length === 0}"
        padding="$space-2"
        width="100%"
        borderRadius="16px"
      >
        <Stack
          horizontalAlignment="center"
          verticalAlignment="center"
          minHeight="260px"
          paddingVertical="$space-5"
        >
          <VStack gap="$space-3" horizontalAlignment="center">
            <Image
              src="resource:clients-empty-list"
              alt="No clients yet"
              width="200px"
              height="138px"
              fit="contain"
            />
            <VStack gap="$space-1" horizontalAlignment="center">
              <Text fontSize="1.125rem" fontWeight="700" textAlign="center" color="$textColor-Heading">
                Your first client is waiting
              </Text>
              <Text variant="secondary" fontSize="$fontSize-xs" textAlign="center">
                Create a client to group projects and keep reports organized.
              </Text>
            </VStack>
          </VStack>
        </Stack>
      </Card>
      <Spinner when="{!clientsDs.loaded}" />
    </VStack>

  </VStack>
</Component>
