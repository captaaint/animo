<Component
  name="Timesheet"
  var.weekStart="{mondayOfWeek(new Date())}"
  var.duplicatePayload="{null}"
>
  <DataSource
    id="entriesDs"
    url="{apiBase + '/time-entries?from=' + weekStart + '&amp;to=' + shiftDate(weekStart, 6) + '&amp;_t=' + entriesTick}"
    credentials="include"
  />
  <DataSource
    id="projectsDs"
    url="{apiBase + '/projects'}"
    credentials="include"
  />
  <DataSource
    id="tagsDs"
    url="{apiBase + '/tags'}"
    credentials="include"
  />
  <DataSource
    id="clientsDs"
    url="{apiBase + '/clients'}"
    credentials="include"
  />

  <Viewport id="vp" />

  <EntryModal
    when="{!vp.value || !vp.value.isMobile}"
    id="entryModal"
    projects="{projectsDs.value || []}"
    tags="{tagsDs.value || []}"
    onSaved="() => entriesDs.refetch()"
    onClosed="() => { if (calendarScreen) calendarScreen.clearSelection(); }"
    onDeleteRequested="(item) => deleteConfirmModal.open(item.id)"
  />

  <EntryDrawer
    when="{vp.value &amp;&amp; vp.value.isMobile}"
    id="entryDrawer"
    projects="{projectsDs.value || []}"
    tags="{tagsDs.value || []}"
    onSaved="() => entriesDs.refetch()"
    onClosed="() => { if (calendarScreenMobile) calendarScreenMobile.clearSelection(); }"
    onDeleteRequested="(item) => deleteConfirmDrawer.open(item)"
  />

  <DeleteConfirmModal
    when="{!vp.value || !vp.value.isMobile}"
    id="deleteConfirmModal"
    onConfirmed="(id) => deleteCall.execute(id)"
  />

  <DeleteConfirmDrawer
    when="{vp.value &amp;&amp; vp.value.isMobile}"
    id="deleteConfirmDrawer"
    projects="{projectsDs.value || []}"
    tags="{tagsDs.value || []}"
    onConfirmed="(id) => deleteCall.execute(id)"
  />

  <APICall id="duplicateCall"
    method="post"
    url="{apiBase + '/time-entries'}"
    credentials="include"
    body="{duplicatePayload}"
    onSuccess="() => { toast.success('Entry duplicated'); entriesDs.refetch(); }"
    onError="() => toast.error('Duplicate failed')" />

  <APICall id="deleteCall"
    method="delete"
    url="{apiBase + '/time-entries/' + $param}"
    credentials="include"
    onSuccess="() => { toast.success('Entry deleted'); entriesDs.refetch(); }"
    onError="() => toast.error('Delete failed')" />

  <!-- Desktop layout: TimerBar is in the AppHeader, so the page body just
       holds the stats Card + main content (Calendar or List by `view`).
       VStack and Card use height="*" so the calendar grows to fill the
       page (works alongside the .xmlui-page-root flex override in index.html). -->
  <VStack when="{!vp.value || !vp.value.isMobile}" height="*" width="*" padding="$space-0" gap="$space-4">
      <CalendarScreen when="{$props.view !== 'list'}"
        id="calendarScreen"
        height="*"
        weekStart="{weekStart}"
        entries="{entriesDs.value || []}"
        projects="{projectsDs.value || []}"
        tags="{tagsDs.value || []}"
        onWeekChange="(v) => weekStart = v"
        onOpenEntry="(e) => entryModal.open(e)"
        onAddSlot="(slot) => entryModal.openForSlot(slot)"
        onSaved="() => entriesDs.refetch()"
      />
      <ListScreen when="{$props.view === 'list'}"
        weekStart="{weekStart}"
        entries="{entriesDs.value || []}"
        projects="{projectsDs.value || []}"
        tags="{tagsDs.value || []}"
        clients="{clientsDs.value || []}"
        onWeekChange="(v) => weekStart = v"
        onOpenEntry="(e) => entryModal.open(e)"
        onAddNew="() => entryModal.open()"
        onDuplicateEntry="(e) => { duplicatePayload = duplicateEntryPayload(e); duplicateCall.execute(); }"
        onDeleteEntry="(e) => deleteConfirmModal.open(e.id)"
      />
  </VStack>

  <!-- Mobile layout: the compact TimerBar is docked to the top of the
       Timesheet content, while the current view fills the remaining space. -->
  <Stack when="{vp.value && vp.value.isMobile}"
    height="*" width="*" gap="$space-2">

      <CalendarScreen when="{$props.view !== 'list'}"
        id="calendarScreenMobile"
        dock="stretch"
        height="*"
        weekStart="{weekStart}"
        entries="{entriesDs.value || []}"
        projects="{projectsDs.value || []}"
        onWeekChange="(v) => weekStart = v"
        onOpenEntry="(e) => entryDrawer.open(e)"
        onAddSlot="(slot) => entryDrawer.openForSlot(slot)"
        onSaved="() => entriesDs.refetch()"
      />
      <ListScreen when="{$props.view === 'list'}"
        dock="stretch"
        weekStart="{weekStart}"
        entries="{entriesDs.value || []}"
        projects="{projectsDs.value || []}"
        tags="{tagsDs.value || []}"
        clients="{clientsDs.value || []}"
        onWeekChange="(v) => weekStart = v"
        onOpenEntry="(e) => entryDrawer.open(e)"
        onAddNew="() => entryDrawer.open()"
        onDuplicateEntry="(e) => { duplicatePayload = duplicateEntryPayload(e); duplicateCall.execute(); }"
        onDeleteEntry="(e) => deleteConfirmDrawer.open(e)"
      />
  </Stack>
</Component>
