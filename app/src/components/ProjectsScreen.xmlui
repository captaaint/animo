<Component name="ProjectsScreen">
  <DataSource
    id="projectsDs"
    url="{apiBase + '/projects'}"
    credentials="include"
  />
  <DataSource
    id="clientsDs"
    url="{apiBase + '/clients'}"
    credentials="include"
  />

  <Viewport id="vp" />

  <ProjectModal
    when="{!vp.value || !vp.value.isMobile}"
    id="projectModal"
    clients="{clientsDs.value || []}"
    onSaved="() => projectsDs.refetch()"
    onDeleteRequested="(item) => deleteConfirmModal.open(item.id)"
  />

  <ProjectDrawer
    when="{vp.value &amp;&amp; vp.value.isMobile}"
    id="projectDrawer"
    clients="{clientsDs.value || []}"
    onSaved="() => projectsDs.refetch()"
    onDeleteRequested="(item) => deleteConfirmDrawer.open(item)"
  />

  <DeleteConfirmModal
    when="{!vp.value || !vp.value.isMobile}"
    id="deleteConfirmModal"
    title="Delete project"
    message="Are you sure you want to delete this project? This action cannot be undone."
    onConfirmed="(id) => deleteCall.execute(id)"
  />

  <DeleteConfirmDrawer
    when="{vp.value &amp;&amp; vp.value.isMobile}"
    id="deleteConfirmDrawer"
    title="Delete project"
    confirmText="Delete this project?"
    message="This action cannot be undone."
    onConfirmed="(id) => deleteCall.execute(id)"
  />

  <APICall
    id="deleteCall"
    method="DELETE"
    url="{apiBase + '/projects/' + $param}"
    credentials="include"
    onSuccess="() => { toast.success('Project deleted'); projectsDs.refetch(); }"
    onError="() => toast.error('Delete failed')"
  />

  <VStack gap="$space-4" padding="0" width="100%" maxWidth="800px" marginHorizontal="auto"
    height="*" overflowY="auto">

    <!-- Desktop/tablet -->
    <HStack when="{!vp.value || !vp.value.isMobile}" verticalAlignment="center">
      <SpaceFiller />
      <Button
        label="New project"
        icon="plus"
        onClick="projectModal.open()"
      />
    </HStack>

    <Card when="{!vp.value || !vp.value.isMobile}" padding="$space-4" borderRadius="16px">
      <Table
        data="{projectsDs.value || []}"
        when="{(projectsDs.value || []).length > 0}"
      >
        <Column header="Color" width="80px">
          <Stack backgroundColor="{$item.color}" width="20px" height="20px" borderRadius="3px" />
        </Column>
        <Column bindTo="name" header="Name">
          <Text>{$item.name}</Text>
        </Column>
        <Column header="Client">
          <Text>
            {((clientsDs.value || []).find(c => c.id === $item.clientId) || {}).name || '—'}
          </Text>
        </Column>
        <Column header="Rate" width="120px">
          <Text>
            {$item.hourlyRate && $item.hourlyRate > 0
            ? ($item.hourlyRate + ' ' + ($item.currency || 'EUR') + '/h')
            : '—'}
          </Text>
        </Column>
        <Column header="Actions" width="100px">
          <HStack gap="$space-1" verticalAlignment="center">
            <Button icon="pencil" size="xs" variant="ghost" themeColor="secondary" padding="$space-2"
              onClick="projectModal.open($item)" />
            <Button icon="trash" size="xs" variant="ghost" themeColor="attention" padding="$space-2"
              onClick="deleteConfirmModal.open($item.id)" />
          </HStack>
        </Column>
      </Table>

      <Stack
        when="{projectsDs.loaded && (projectsDs.value || []).length === 0}"
        horizontalAlignment="center"
        verticalAlignment="center"
        minHeight="320px"
        paddingVertical="$space-8"
      >
        <VStack gap="$space-3" horizontalAlignment="center">
          <Image
            src="resource:projects-empty-list"
            alt="No projects yet"
            width="147px"
            height="147px"
            fit="contain"
          />
          <VStack gap="$space-1" horizontalAlignment="center">
            <Text fontSize="1.25rem" fontWeight="700" textAlign="center" color="$textColor-Heading">
              Your first project is waiting
            </Text>
            <Text variant="secondary" fontSize="$fontSize-small" textAlign="center">
              Create a project to get started and keep everything organized.
            </Text>
          </VStack>
        </VStack>
      </Stack>
      <Spinner when="{!projectsDs.loaded}" />
    </Card>

    <!-- Mobile: flat list rows with two-line content and three-dot menu -->
    <VStack when="{vp.value &amp;&amp; vp.value.isMobile}" gap="$space-3">
      <Button
        width="100%"
        label="New project"
        icon="plus"
        onClick="projectDrawer.open()"
      />

      <Card when="{(projectsDs.value || []).length > 0}" padding="$space-2" width="100%" borderRadius="16px">
        <Items data="{projectsDs.value || []}">
          <VStack gap="0">
            <HStack
              verticalAlignment="center"
              paddingVertical="$space-3"
              paddingHorizontal="$space-2"
              gap="$space-3"
            >
              <VStack gap="$space-1">
                <HStack verticalAlignment="center" gap="$space-2">
                  <Stack backgroundColor="{$item.color}" width="14px" height="14px" borderRadius="3px" />
                  <Text fontWeight="600" fontSize="$fontSize-small">{$item.name}</Text>
                </HStack>
                <HStack gap="$space-2">
                  <Stack width="14px" />
                  <Text variant="secondary" fontSize="$fontSize-xs">
                    {((clientsDs.value || []).find(c => c.id === $item.clientId) || {}).name || '—'}
                  </Text>
                </HStack>
              </VStack>
              <SpaceFiller />
              <Text variant="secondary" fontSize="$fontSize-small">
                {$item.hourlyRate && $item.hourlyRate > 0
                ? ($item.hourlyRate + ' ' + ($item.currency || 'EUR') + '/h')
                : '—'}
              </Text>
              <DropdownMenu alignment="end">
                <property name="triggerTemplate">
                  <Button icon="dotmenu" variant="ghost" size="sm" themeColor="secondary" />
                </property>
                <MenuItem icon="pencil" onClick="projectDrawer.open($item)">Edit</MenuItem>
                <MenuSeparator />
                <MenuItem icon="trash" onClick="deleteConfirmDrawer.open($item)">Delete</MenuItem>
              </DropdownMenu>
            </HStack>
            <ContentSeparator when="{!$isLast}" />
          </VStack>
        </Items>
      </Card>

      <Card when="{projectsDs.loaded && (projectsDs.value || []).length === 0}"
        padding="$space-2" width="100%" borderRadius="16px">
        <Stack
          horizontalAlignment="center"
          verticalAlignment="center"
          minHeight="260px"
          paddingVertical="$space-5"
        >
          <VStack gap="$space-3" horizontalAlignment="center">
            <Image
              src="resource:projects-empty-list"
              alt="No projects yet"
              width="133px"
              height="133px"
              fit="contain"
            />
            <VStack gap="$space-1" horizontalAlignment="center">
              <Text fontSize="1.125rem" fontWeight="700" textAlign="center" color="$textColor-Heading">
                Your first project is waiting
              </Text>
              <Text variant="secondary" fontSize="$fontSize-xs" textAlign="center">
                Create a project to get started and keep everything organized.
              </Text>
            </VStack>
          </VStack>
        </Stack>
      </Card>
      <Spinner when="{!projectsDs.loaded}" />
    </VStack>

  </VStack>
</Component>
