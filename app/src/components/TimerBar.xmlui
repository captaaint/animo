<Component name="TimerBar"
  var.descr="{''}"
  var.projectId="{null}"
  var.tagIds="{[]}"
  var.pendingStart="{null}"
  var.pendingEnd="{null}"
  var.projectSearch="{''}"
  var.tagSearch="{''}"
>
  <Stopwatch id="sw"
    label="{descr}"
    onStop="(p) => {
      if ($props.compact) {
        emitEvent('counterStop', { startTime: p.startTime, endTime: p.endTime, description: descr, projectId: projectId, tagIds: tagIds });
        descr = '';
        tagIds = [];
      } else {
        pendingStart = p.startTime;
        pendingEnd = p.endTime;
        saveCounterCall.execute();
      }
    }"
    onResume="(p) => {
      const newDescr = (p && p.description) ? p.description : '';
      descr = newDescr;
      projectId = (p && p.projectId) ? p.projectId : null;
      if (typeof descrFull !== 'undefined' && descrFull) descrFull.setValue(newDescr);
      if (typeof descrCompact !== 'undefined' && descrCompact) descrCompact.setValue(newDescr);
    }"
  />

  <APICall id="saveCounterCall"
    method="POST"
    url="{apiBase + '/time-entries'}"
    credentials="include"
    body="{{
      projectId: projectId || null,
      description: descr || '',
      startTime: pendingStart,
      endTime: pendingEnd,
      tagIds: tagIds || []
    }}"
    onSuccess="() => {
      toast.success('Entry saved');
      pendingStart = null;
      pendingEnd = null;
      descr = '';
      tagIds = [];
      emitEvent('saved');
    }"
    onError="() => { pendingStart = null; pendingEnd = null; toast.error('Save failed'); }"
  />

  <!-- In-app keyboard shortcut: press "t" (when not typing in a field) to
       start/stop the timer, mirroring the play/stop buttons. ignoreInInputs
       keeps it from hijacking the description box and other inputs; the default
       ignoreWithModifiers also lets the desktop global hotkey
       (Cmd/Ctrl+Shift+T) through untouched, so the two never double-fire. -->
  <KeyListener keys="t,T" ignoreInInputs="true"
    onKey="() => { if (sw.value && sw.value.running) sw.stop(); else sw.start(); }" />

  <!-- Compact: single-row input + icon-only play/stop button. On stop the
       parent opens EntryModal so the user can review the description, project,
       and time range before persisting. -->
  <Card when="{$props.compact}" padding="$space-2">
    <HStack verticalAlignment="center" gap="$space-2" width="*">
      <TextBox id="descrCompact" width="*"
        placeholder="What are you working on?"
        initialValue="{descr}"
        onDidChange="(v) => descr = v"
        variant="ghost" />
      <Text when="{sw.value && sw.value.running}"
        fontFamily="monospace" fontWeight="bold">
        {sw.value.display}
      </Text>
      <Button when="{!sw.value || !sw.value.running}"
        label="▶" themeColor="primary" size="sm"
        tooltip="Start the timer (T)"
        onClick="sw.start()" />
      <Button when="{sw.value && sw.value.running}"
        label="■" themeColor="attention" size="sm"
        tooltip="Stop the timer (T)"
        onClick="sw.stop()" />
    </HStack>
  </Card>

  <!-- Full (desktop) layout: borderless toolbar. The description input takes
       all leftover space (via star sizing); the right-side group (timer +
       play/stop) keeps its natural width. -->
  <HStack when="{!$props.compact}" verticalAlignment="center" gap="$space-3" width="100%">
    <TextBox id="descrFull" width="*"
      placeholder="What are you working on?"
      initialValue="{descr}"
      onDidChange="(v) => descr = v"
      variant="ghost" />

    <!-- Project picker: ark-ui Combobox-backed Picker extension. Searchable,
         single-select, grouped by client. -->
    <Picker
      icon="folder"
      data="{projectsForPicker($props.projects, $props.clients, '')}"
      valueField="id"
      labelField="name"
      groupField="clientName"
      colorField="color"
      searchPlaceholder="Search project or client"
      value="{projectId}"
      onDidChange="(v) => projectId = v" />

    <!-- Tag picker: same component, multi-select. -->
    <Picker
      icon="hash"
      multiSelect="true"
      data="{$props.tags || []}"
      valueField="id"
      labelField="name"
      colorField="color"
      searchPlaceholder="Search tag"
      value="{tagIds}"
      onDidChange="(v) => tagIds = v || []" />

    <!-- Keycap hint: surfaces the in-app "T" shortcut so it's discoverable
         without hovering a button. -->
    <HStack verticalAlignment="center"
      borderWidth="1px" borderColor="$borderColor"
      borderRadius="4px" paddingHorizontal="5px"
      tooltip="Press T to start or stop the timer">
      <Text fontSize="$fontSize-xs" variant="secondary" fontFamily="monospace">T</Text>
    </HStack>
    <Text fontFamily="monospace" fontSize="1.25rem" fontWeight="bold">
      {sw.value && sw.value.display ? sw.value.display : '0:00:00'}
    </Text>
    <Button when="{!sw.value || !sw.value.running}"
      label="▶" themeColor="primary"
      tooltip="Start the timer (T)"
      onClick="sw.start()" />
    <Button when="{sw.value && sw.value.running}"
      label="■" themeColor="attention"
      tooltip="Stop the timer (T)"
      onClick="sw.stop()" />
  </HStack>
</Component>
