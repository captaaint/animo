<Component name="ImportScreen">
  <VStack
    width="*"
    maxWidth="900px"
    marginHorizontal="auto"
    gap="$space-4"
    padding="$space-4"
  >
    <Card padding="$space-4">
      <VStack gap="$space-3">
        <HStack verticalAlignment="center" gap="$space-2">
          <Icon name="upload" size="lg" color="$color-primary-500" />
          <Text fontWeight="700" fontSize="1.375rem">
            Data import
          </Text>
        </HStack>
        <ImportFlow />
      </VStack>
    </Card>
  </VStack>
</Component>
