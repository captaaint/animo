<Component
  name="ListScreen"
  var.searchText="{''}"
  var.searchedEntries="{filterEntries($props.entries || [], searchText, [], $props.projects || [], $props.clients || [], $props.tags || [])}"
  var.groupedDays="{groupEntriesByDay(entriesForListTable(searchedEntries, $props.projects || []))}"
  var.listDays="{listViewDays(groupedDays, $props.projects || [], $props.tags || [])}"
>
  <VStack gap="$space-4">
    <Card gap="$space-4">
      <HStack
        when-xs="false"
        when-sm="true"
        verticalAlignment="center"
        width="100%"
        gap="$space-4"
      >
        <HStack verticalAlignment="center" gap="$space-2">
          <Button
            variant="solid"
            size="sm"
            label="◀"
            onClick="emitEvent('weekChange', shiftDate($props.weekStart, -7))"
          />
          <Button
            variant="solid"
            size="sm"
            label="Today"
            onClick="emitEvent('weekChange', mondayOfWeek(new Date()))"
          />
          <Button
            variant="solid"
            size="sm"
            label="▶"
            onClick="emitEvent('weekChange', shiftDate($props.weekStart, 7))"
          />
        </HStack>
        <SpaceFiller />
        <Text fontWeight="bold">
          {formatMonthDay($props.weekStart)}
        </Text>
        <SpaceFiller />
        <HStack gap="$space-4" verticalAlignment="center">
          <HStack gap="$space-1" verticalAlignment="center">
            <Text variant="secondary" fontSize="$fontSize-small">
              Today
            </Text>
            <Text fontWeight="bold">
              {formatDuration(dayTotalSeconds($props.entries || [], toIsoDate(new Date())))}
            </Text>
          </HStack>
          <HStack gap="$space-1" verticalAlignment="center">
            <Text variant="secondary" fontSize="$fontSize-small">
              This week
            </Text>
            <Text fontWeight="bold">
              {formatDuration(weekTotalSeconds($props.entries || [], mondayOfWeek(new Date())))}
            </Text>
          </HStack>
        </HStack>
      </HStack>
      <VStack when-xs="true" when-sm="false" width="100%" gap="$space-3">
        <HStack verticalAlignment="center" width="100%">
          <Button
            variant="solid"
            size="sm"
            label="◀"
            onClick="emitEvent('weekChange', shiftDate($props.weekStart, -7))"
          />
          <SpaceFiller />
          <Text fontWeight="bold" fontSize="$fontSize-large">
            {formatMonthDay($props.weekStart)}
          </Text>
          <SpaceFiller />
          <Button
            variant="solid"
            size="sm"
            label="▶"
            onClick="emitEvent('weekChange', shiftDate($props.weekStart, 7))"
          />
        </HStack>
        <HStack width="100%" verticalAlignment="center">
          <VStack horizontalAlignment="center" gap="$space-1" width="*">
            <Text variant="secondary" fontSize="$fontSize-tiny">Today</Text>
            <Text fontWeight="bold" fontSize="$fontSize-large" color="$color-primary-600">
              {formatDuration(dayTotalSeconds($props.entries || [], toIsoDate(new Date())))}
            </Text>
          </VStack>
          <Stack width="1px" height="40px" backgroundColor="$color-surface-200" />
          <VStack horizontalAlignment="center" gap="$space-1" width="*">
            <Text variant="secondary" fontSize="$fontSize-tiny">This week</Text>
            <Text fontWeight="bold" fontSize="$fontSize-large" color="$color-primary-600">
              {formatDuration(weekTotalSeconds($props.entries || [], mondayOfWeek(new Date())))}
            </Text>
          </VStack>
        </HStack>
        <Button when-xs="true" when-sm="false" width="100%" label="New entry" icon="plus" onClick="emitEvent('addNew')" />
      </VStack>
      <HStack when-xs="false" when-sm="true" width="100%" gap="$space-2" verticalAlignment="center">
        <TextBox
          width="*"
          placeholder="Search description, project, client, tag…"
          startIcon="search"
          testId="list-search"
          initialValue="{searchText}"
          onDidChange="(v) => searchText = v || ''"
        />
        <Button label="New entry" icon="plus" onClick="emitEvent('addNew')" />
      </HStack>
    </Card>
    <Card height="*" when-xs="false" when-sm="true">
      <TimeEntriesEmptyState
        when="{searchedEntries.length === 0}"
        title="{searchText ? 'No entries match your search' : 'No entries this week'}"
        subtitle="{searchText ? 'Try another search term or clear the search field.' : 'Add your first time entry to start tracking this week.'}"
      />
      <VStack
        when-xs="false"
        when-sm="true"
        when="{searchedEntries.length > 0}"
        gap="0"
      >
        <!-- Plain-React list (extensions/EntryList): the previous Items →
             ExpandableItem → Table markup re-rendered every templated cell
             many times on mount and froze the page for seconds with a
             normal week of entries. -->
        <EntryList
          layout="table"
          days="{listDays}"
          onOpenEntry="(e) => emitEvent('openEntry', e)"
          onDuplicateEntry="(e) => emitEvent('duplicateEntry', e)"
          onDeleteEntry="(e) => emitEvent('deleteEntry', e)"
          onAddNew="() => emitEvent('addNew')"
        />
      </VStack>
    </Card>
    <VStack when-xs="true" when-sm="false" gap="$space-2">
      <Card>
        <TextBox
          width="100%"
          placeholder="Search description, project, client, tag…"
          startIcon="search"
          testId="list-search"
          initialValue="{searchText}"
          onDidChange="(v) => searchText = v || ''"
        />
      </Card>
      <Card when="{searchedEntries.length === 0}">
        <TimeEntriesEmptyState
          title="{searchText ? 'No entries match your search' : 'No entries this week'}"
          subtitle="{searchText ? 'Try another search term or clear the search field.' : 'Add your first time entry to start tracking this week.'}"
          minHeight="260px"
          paddingVertical="$space-5"
          imageWidth="200px"
          imageHeight="138px"
          titleSize="1.125rem"
          subtitleSize="$fontSize-xs"
        />
      </Card>
      <VStack
        when="{searchedEntries.length > 0}"
        gap="$space-4"
      >
        <EntryList
          layout="cards"
          days="{listDays}"
          onOpenEntry="(e) => emitEvent('openEntry', e)"
          onDuplicateEntry="(e) => emitEvent('duplicateEntry', e)"
          onDeleteEntry="(e) => emitEvent('deleteEntry', e)"
          onAddNew="() => emitEvent('addNew')"
        />
      </VStack>
    </VStack>
  </VStack>
</Component>
