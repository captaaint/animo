<Component name="SettingsScreen">
  <HStack width="*" horizontalAlignment="center">
    <Card maxWidth="720px" width="*" padding="$space-4" gap="$space-4">
      <VStack gap="$space-3">
        <Text variant="secondary" fontSize="$fontSize-small">
          Local profile
        </Text>
        <ContentSeparator />

        <Stack>
          <HStack verticalAlignment="center" gap="$space-3">
            <Avatar
              size="md"
              name="{$props.userName || 'Local User'}"
              backgroundColor="$color-surface-100"
              color="$color-surface-900"
              border="1px solid $color-surface-300"
            />
            <VStack gap="$space-0">
              <Text>{$props.userName || 'Local User'}</Text>
              <Text variant="secondary" fontSize="$fontSize-small">
                {$props.username ? '@' + $props.username : 'Local workspace'}
              </Text>
            </VStack>
          </HStack>
        </Stack>
      </VStack>

      <VStack gap="$space-3">
        <Text variant="secondary" fontSize="$fontSize-small">
          Appearance
        </Text>
        <ContentSeparator />

        <Stack>
          <HStack
            verticalAlignment="center"
            gap="$space-3"
            paddingVertical="$space-3"
          >
            <Icon name="palette" size="18px" />
            <Text>Theme</Text>
            <SpaceFiller />
            <Text variant="secondary" fontSize="$fontSize-small">Light</Text>
            <ToneSwitch />
          </HStack>
        </Stack>
      </VStack>

    </Card>
  </HStack>
</Component>
