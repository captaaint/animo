{
  "name": "animo",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "api": "DATABASE_URL=\"sqlite:dev.db?mode=rwc\" cargo run -p animo-api",
    "api:demo": "DATABASE_URL=\"sqlite:demo.db?mode=rwc\" cargo run -p animo-api",
    "api:prod": "DATABASE_URL=\"sqlite:prod.db?mode=rwc\" cargo run -p animo-api --release",
    "seed:demo": "DATABASE_URL=\"sqlite:demo.db?mode=rwc\" cargo run -p animo-api --bin seed_demo",
    "web": "cd web && npm run start",
    "web:demo": "cd web && VITE_ANIMO_DEMO=true npm run start",
    "dev": "concurrently -k -n api,web -c green,cyan \"npm:api\" \"npm:web\"",
    "dev:demo": "concurrently -k -n api,web -c green,cyan \"npm:api:demo\" \"npm:web\"",
    "dev:prod": "concurrently -k -n api,web -c green,cyan \"npm:api:prod\" \"npm:web\"",
    "website": "cd website && npm run start",
    "website:dev": "concurrently -k -n web,site -c cyan,magenta \"npm:web:demo\" \"VITE_ANIMO_DEMO_URL=http://localhost:5173 npm run website\"",
    "website:build": "cd website && npm run build:with-demo",
    "website:preview": "cd website && npm run preview",
    "tauri": "cd desktop && tauri",
    "tauri:dev": "cd desktop && tauri dev",
    "tauri:build": "cd desktop && tauri build",
    "build:demo": "cd web && npm run build:demo",
    "preview:demo": "cd web && npm run preview:demo",
    "e2e": "cd e2e && npm test",
    "e2e:ui": "cd e2e && npm run test:ui",
    "e2e:headed": "cd e2e && npm run test:headed",
    "e2e:report": "cd e2e && npm run report",
    "e2e:install": "cd e2e && npm install && npm run install-browsers",
    "e2e:gen-from-trace": "node e2e/.trace-tools/generate-playwright.js",
    "e2e:watch-traces": "cd e2e && npm run watch-traces"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2",
    "concurrently": "^9.1.0"
  }
}
