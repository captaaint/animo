<Component
  name="ReportsScreen"
  var.fromDate="{mondayOfWeek(new Date())}"
  var.toDate="{shiftDate(mondayOfWeek(new Date()), 6)}"
  var.progress="{0}"
  var.searchText="{''}"
  var.projectFilter="{[]}"
  var.tagFilter="{[]}"
  var.sliceBy="{'billable'}"
  var.distData="{((fe) => sliceBy === 'project' ? Object.values(fe.reduce((acc, e) => { const p = (projectsDs.value || []).find(pp => pp.id === e.projectId); const key = p ? String(p.id) : '__none__'; if (!acc[key]) acc[key] = { label: p ? p.name : 'No project', seconds: 0, color: p ? p.color : '#C2BDB7' }; acc[key].seconds += (e.durationSeconds || 0); return acc; }, {})) : sliceBy === 'client' ? Object.values(fe.reduce((acc, e) => { const p = (projectsDs.value || []).find(pp => pp.id === e.projectId); const c = p ? (clientsDs.value || []).find(cc => cc.id === p.clientId) : null; const key = c ? String(c.id) : '__none__'; if (!acc[key]) acc[key] = { label: c ? c.name : 'No client', seconds: 0, color: c ? c.color : '#C2BDB7' }; acc[key].seconds += (e.durationSeconds || 0); return acc; }, {})) : sliceBy === 'tag' ? fe.reduce((acc, e) => { const tags = tagsForIds(e.tagIds || [], tagsDs.value || []); if (tags.length === 0) { const ex = acc.find(a => a.label === 'No tag'); if (ex) ex.seconds += (e.durationSeconds || 0); else acc.push({ label: 'No tag', seconds: e.durationSeconds || 0, color: '#C2BDB7' }); } else { tags.forEach(t => { const ex = acc.find(a => a.label === t.name); if (ex) ex.seconds += (e.durationSeconds || 0); else acc.push({ label: t.name, seconds: e.durationSeconds || 0, color: t.color }); }); } return acc; }, []) : [{ label: 'Billable', seconds: sumBillableSeconds(fe) }, { label: 'Non-billable', seconds: sumDurationSeconds(fe) - sumBillableSeconds(fe) }])(applyReportFilters(((summaryDs.value || {}).entries) || [], projectFilter, tagFilter))}"
>
  <Viewport id="vp" />

  <DataSource
    id="summaryDs"
    url="{apiBase + '/reports/summary?from=' + fromDate + '&amp;to=' + toDate}"
    credentials="include"
  />
  <DataSource
    id="projectsDs"
    url="{apiBase + '/projects'}"
    credentials="include"
  />
  <DataSource
    id="clientsDs"
    url="{apiBase + '/clients'}"
    credentials="include"
  />
  <DataSource
    id="tagsDs"
    url="{apiBase + '/tags'}"
    credentials="include"
  />
  <DataSource
    id="meDs"
    url="{apiBase + '/auth/me'}"
    credentials="include"
  />

  <ModalDialog
    id="progressModal"
    padding="$space-4"
    title="Generating report"
    maxWidth="420px"
  >
    <VStack gap="$space-4" padding="$space-2">
      <Text>
        Preparing your PDF…
      </Text>
      <ProgressBar value="{progress}" />
      <Text variant="secondary" fontSize="$fontSize-small">
        {progress >= 1 ? 'Done' : Math.round((progress || 0) * 100) + '%'}
      </Text>
    </VStack>
  </ModalDialog>

  <ModalDialog
    id="pdfPreview"
    closeButtonVisible="false"
    maxWidth="980px"
    height="95vh"
    padding="$space-0"
    onClose="if ($param &amp;&amp; $param.url) window.revokeBlobUrl($param.url);"
  >
    <VStack height="*" width="*" gap="$space-0" backgroundColor="$color-surface-100">
      <Stack height="*" width="*" minHeight="0" padding="$space-5">
        <Pdf
          id="pdfPreviewViewer"
          src="{$param.url}"
          width="*"
          height="*"
          horizontalAlignment="center"
          scrollStyle="whenScrolling"
          onDocumentLoad="pdfPreviewViewer.fitWidth()"
        />
      </Stack>
      <HStack
        width="*"
        verticalAlignment="center"
        padding="$space-3"
        backgroundColor="$color-surface-0"
        borderTop="1px solid $color-surface-200"
      >
        <Button
          label="Discard"
          variant="ghost"
          onClick="pdfPreview.close()"
        />
        <SpaceFiller />
        <Button
          label="Download"
          themeColor="primary"
          icon="download"
          onClick="window.downloadBlobUrl($param.url, $param.fileName); pdfPreview.close();"
        />
      </HStack>
    </VStack>
  </ModalDialog>

  <EntryModal
    id="entryModal"
    projects="{projectsDs.value || []}"
    tags="{tagsDs.value || []}"
    onSaved="() => summaryDs.refetch()"
  />

  <APICall
    id="duplicateCall"
    method="POST"
    url="{apiBase + '/time-entries'}"
    credentials="include"
    body="{$param}"
    onSuccess="() => { toast.success('Entry duplicated'); summaryDs.refetch(); }"
    onError="() => toast.error('Duplicate failed')"
  />

  <APICall
    id="deleteCall"
    method="DELETE"
    url="{apiBase + '/time-entries/' + $param}"
    credentials="include"
    confirmTitle="Delete entry"
    confirmMessage="Delete this entry?"
    onSuccess="() => { toast.success('Entry deleted'); summaryDs.refetch(); }"
    onError="() => toast.error('Delete failed')"
  />

  <!-- Cross-tree export trigger: AppHeader's "Export PDF" button dispatches
       `tt:export-report`. Inline the export logic here so the listener has
       access to the ids/state it needs. -->
  <WindowEvent
    eventName="tt:export-report"
    onMessage="() => {
      progress = 0;
      progressModal.open();
      const allEntries = ((summaryDs.value || {}).entries) || [];
      const filtered = applyReportFilters(allEntries, projectFilter, tagFilter);
      const projects = projectsDs.value || [];
      const clients = clientsDs.value || [];
      const allTags = tagsDs.value || [];
      const enriched = filtered.map((e) => {
        const p = projects.find((pp) => pp.id === e.projectId);
        const c = p &amp;&amp; clients.find((cc) => cc.id === p.clientId);
        return {
          description: e.description || '',
          projectName: p ? p.name : (e.projectName || null),
          projectColor: p ? p.color : null,
          clientName: c ? c.name : (e.clientName || null),
          durationSeconds: e.durationSeconds != null
            ? e.durationSeconds
            : Math.round((new Date(e.endTime).getTime() - new Date(e.startTime).getTime()) / 1000),
          date: (e.startTime || '').slice(0, 10),
          tags: tagsForIds(e.tagIds, allTags).map((t) => ({ name: t.name, color: t.color }))
        };
      });
      window.generateReportPdf(
        {
          fromDate: fromDate,
          toDate: toDate,
          user: ((meDs.value || {}).user) || { name: 'User', email: '' },
          totalSeconds: sumDurationSeconds(filtered),
          entries: enriched
        },
        (blobUrl) => {
          progressModal.close();
          pdfPreview.open({
            url: blobUrl,
            fileName: 'report_' + fromDate + '_' + toDate + '.pdf'
          });
        },
        (err) => {
          progressModal.close();
          toast.error('Export failed: ' + err);
        },
        (ratio) => { progress = ratio; }
      );
    }"
  />

  <VStack
    gap="$space-4"
    padding="0"
    width="*"
    height="*"
    overflowY="auto"
  >
    <!-- Filter card: date range + client + project + tag selectors -->
    <Card padding="$space-4">
      <HStack
        gap="$space-2"
        verticalAlignment="center"
        width="100%"
        wrapContent
      >
        <DatePicker
          label="Date range"
          id="rangePicker"
          mode="range"
          weekStartsOn="1"
          showWeekNumber="true"
          dateFormat="yyyy-MM-dd"
          initialValue="{{ from: fromDate, to: toDate }}"
          onDidChange="(v) => {
              if (!v || typeof v !== 'object') return;
              if (v.from &amp;&amp; v.from !== fromDate) fromDate = v.from;
              if (v.to &amp;&amp; v.to !== toDate) toDate = v.to;
            }"
        />

        <AutoComplete
          label="Projects"
          id="projectFilterSel"
          width="*"
          minWidth="300px"
          placeholder="Search project or client"
          multi="true"
          initialValue="{projectFilter}"
          groupBy="clientName"
          testId="filter-project"
          onDidChange="(v) => projectFilter = v || []"
        >
          <property name="groupHeaderTemplate">
            <Text>
              {($group || '').toUpperCase()}
            </Text>
          </property>
          <Items
            data="{projectOptionsGroupedByClient(projectsDs.value || [], clientsDs.value || [])}"
          >
            <Option
              value="{$item.id}"
              label="{$item.name}"
              keywords="{$item.keywords}"
              clientName="{$item.clientName}"
            >
              <HStack verticalAlignment="center" gap="$space-2">
                <Stack
                  width="10px"
                  height="10px"
                  borderRadius="3px"
                  backgroundColor="{$item.color}"
                />
                <Text>
                  {$item.name}
                </Text>
              </HStack>
            </Option>
          </Items>
        </AutoComplete>
        <AutoComplete
          label="Tags"
          id="tagFilterSel"
          width="*"
          minWidth="240px"
          placeholder="Search tag"
          multi="true"
          initialValue="{tagFilter}"
          testId="filter-tag"
          onDidChange="(v) => tagFilter = v || []"
        >
          <Items data="{tagsDs.value || []}">
            <Option
              value="{$item.id}"
              label="{$item.name}"
              keywords="{[$item.name]}"
            >
              <HStack verticalAlignment="center" gap="$space-2">
                <Stack
                  width="10px"
                  height="10px"
                  borderRadius="3px"
                  backgroundColor="{$item.color}"
                />
                <Text>
                  {$item.name}
                </Text>
              </HStack>
            </Option>
          </Items>
        </AutoComplete>
      </HStack>
      <HStack width="100%" verticalAlignment="center">
        <Button
          label="Clear filters"
          variant="ghost"
          size="sm"
          testId="filter-clear"
          enabled="{(projectFilter &amp;&amp; projectFilter.length > 0) || (tagFilter &amp;&amp; tagFilter.length > 0)}"
          onClick="
            projectFilter = [];
            tagFilter = [];
            if (projectFilterSel) projectFilterSel.setValue([]);
            if (tagFilterSel) tagFilterSel.setValue([]);
          "
        />
        <SpaceFiller />
        <Button
          label="Export PDF"
          icon="doc"
          width="fit-content"
          variant="ghost"
          testId="header-export-pdf"
          onClick="window.ttExportReport()"
        />
      </HStack>
    </Card>

    <!-- KPI cards – desktop: single row, mobile: 2×2 -->
    <HStack when-xs="false" when-sm="true" gap="$space-4">
      <Card width="*">
        <HStack gap="$space-3" verticalAlignment="center">
          <Stack backgroundColor="$color-primary-100" borderRadius="$borderRadius" padding="$space-3" color="$color-primary-500">
            <Icon name="clock" size="md" />
          </Stack>
          <VStack gap="$space-1">
            <Text variant="secondary" fontWeight="bold" fontSize="$fontSize-xs">Total Hours</Text>
            <Text fontWeight="600" fontSize="1.1rem">{formatDuration(sumDurationSeconds(applyReportFilters(((summaryDs.value || {}).entries) || [], projectFilter, tagFilter)))}</Text>
          </VStack>
        </HStack>
      </Card>
      <Card width="*">
        <HStack gap="$space-3" verticalAlignment="center">
          <Stack backgroundColor="$color-primary-100" borderRadius="$borderRadius" padding="$space-3" color="$color-primary-500">
            <Icon name="file-text" size="md" />
          </Stack>
          <VStack gap="$space-1">
            <Text variant="secondary" fontWeight="bold" fontSize="$fontSize-xs">Billable Hours</Text>
            <Text fontWeight="600" fontSize="1.1rem">{sumBillableSeconds(applyReportFilters(((summaryDs.value || {}).entries) || [], projectFilter, tagFilter)) === 0 ? '—' : formatDuration(sumBillableSeconds(applyReportFilters(((summaryDs.value || {}).entries) || [], projectFilter, tagFilter)))}</Text>
          </VStack>
        </HStack>
      </Card>
      <Card width="*">
        <HStack gap="$space-3" verticalAlignment="center">
          <Stack backgroundColor="$color-primary-100" borderRadius="$borderRadius" padding="$space-3" color="$color-primary-500">
            <Icon name="credit-card" size="md" />
          </Stack>
          <VStack gap="$space-1">
            <Text variant="secondary" fontWeight="bold" fontSize="$fontSize-xs">Amount</Text>
            <Text fontWeight="600" fontSize="1.1rem">{amountsFromEntries(applyReportFilters(((summaryDs.value || {}).entries) || [], projectFilter, tagFilter)).length === 0 ? '—' : amountsFromEntries(applyReportFilters(((summaryDs.value || {}).entries) || [], projectFilter, tagFilter)).map(a => a.amount.toFixed(2) + ' ' + a.currency).join(' + ')}</Text>
          </VStack>
        </HStack>
      </Card>
      <Card width="*">
        <HStack gap="$space-3" verticalAlignment="center">
          <Stack backgroundColor="$color-primary-100" borderRadius="$borderRadius" padding="$space-3" color="$color-primary-500">
            <Icon name="trending-up" size="md" />
          </Stack>
          <VStack gap="$space-1">
            <Text variant="secondary" fontWeight="bold" fontSize="$fontSize-xs">Average Daily Hours</Text>
            <Text fontWeight="600" fontSize="1.1rem">{formatDuration(rangeAverageSecondsFromDaily(dailyTotalsFromEntries(applyReportFilters(((summaryDs.value || {}).entries) || [], projectFilter, tagFilter), fromDate, toDate)))}</Text>
          </VStack>
        </HStack>
      </Card>
    </HStack>

    <VStack when-xs="true" when-sm="false" gap="$space-4">
      <HStack gap="$space-4">
        <Card width="*">
          <HStack gap="$space-3" verticalAlignment="center">
            <Stack backgroundColor="$color-primary-100" borderRadius="$borderRadius" padding="$space-3" color="$color-primary-500">
              <Icon name="clock" size="md" />
            </Stack>
            <VStack gap="$space-1">
              <Text variant="secondary" fontWeight="bold" fontSize="$fontSize-xs">Total Hours</Text>
              <Text fontWeight="600" fontSize="1.1rem">{formatDuration(sumDurationSeconds(applyReportFilters(((summaryDs.value || {}).entries) || [], projectFilter, tagFilter)))}</Text>
            </VStack>
          </HStack>
        </Card>
        <Card width="*">
          <HStack gap="$space-3" verticalAlignment="center">
            <Stack backgroundColor="$color-primary-100" borderRadius="$borderRadius" padding="$space-3" color="$color-primary-500">
              <Icon name="file-text" size="md" />
            </Stack>
            <VStack gap="$space-1">
              <Text variant="secondary" fontWeight="bold" fontSize="$fontSize-xs">Billable Hours</Text>
              <Text fontWeight="600" fontSize="1.1rem">{sumBillableSeconds(applyReportFilters(((summaryDs.value || {}).entries) || [], projectFilter, tagFilter)) === 0 ? '—' : formatDuration(sumBillableSeconds(applyReportFilters(((summaryDs.value || {}).entries) || [], projectFilter, tagFilter)))}</Text>
            </VStack>
          </HStack>
        </Card>
      </HStack>
      <HStack gap="$space-4">
        <Card width="*">
          <HStack gap="$space-3" verticalAlignment="center">
            <Stack backgroundColor="$color-primary-100" borderRadius="$borderRadius" padding="$space-3" color="$color-primary-500">
              <Icon name="credit-card" size="md" />
            </Stack>
            <VStack gap="$space-1">
              <Text variant="secondary" fontWeight="bold" fontSize="$fontSize-xs">Amount</Text>
              <Text fontWeight="600" fontSize="1.1rem">{amountsFromEntries(applyReportFilters(((summaryDs.value || {}).entries) || [], projectFilter, tagFilter)).length === 0 ? '—' : amountsFromEntries(applyReportFilters(((summaryDs.value || {}).entries) || [], projectFilter, tagFilter)).map(a => a.amount.toFixed(2) + ' ' + a.currency).join(' + ')}</Text>
            </VStack>
          </HStack>
        </Card>
        <Card width="*">
          <HStack gap="$space-3" verticalAlignment="center">
            <Stack backgroundColor="$color-primary-100" borderRadius="$borderRadius" padding="$space-3" color="$color-primary-500">
              <Icon name="trending-up" size="md" />
            </Stack>
            <VStack gap="$space-1">
              <Text variant="secondary" fontWeight="bold" fontSize="$fontSize-xs">Average Daily Hours</Text>
              <Text fontWeight="600" fontSize="1.1rem">{formatDuration(rangeAverageSecondsFromDaily(dailyTotalsFromEntries(applyReportFilters(((summaryDs.value || {}).entries) || [], projectFilter, tagFilter), fromDate, toDate)))}</Text>
            </VStack>
          </HStack>
        </Card>
      </HStack>
    </VStack>

    <!-- Charts: side-by-side on desktop, stacked on mobile -->
    <HStack
      when="{!vp.value || !vp.value.isMobile}"
      width="*"
      gap="$space-4"
      verticalAlignment="stretch"
    >
      <Card width="*" minWidth="0" padding="$space-6" gap="$space-4">
        <H3>
          Daily hours
        </H3>
        <Stack height="280px" width="*">
          <BarChart
            orientation="vertical"
            data="{dailyTotalsFromEntries(applyReportFilters(((summaryDs.value || {}).entries) || [], projectFilter, tagFilter), fromDate, toDate).map(d => ({ day: d.date.slice(5), hours: Math.round((d.seconds / 3600) * 100) / 100 }))}"
            dataKeys="{['hours']}"
            nameKey="day"
          />
        </Stack>
      </Card>

      <Card width="*" minWidth="0" padding="$space-6" gap="$space-4">
        <HStack verticalAlignment="center">
          <H3>{sliceBy === 'project' ? 'Project' : sliceBy === 'client' ? 'Client' : sliceBy === 'tag' ? 'Tag' : 'Billable'} distribution</H3>
          <SpaceFiller />
          <DropdownMenu alignment="end">
            <property name="triggerTemplate">
              <Button
                variant="outlined"
                size="sm"
                label="{sliceBy === 'project' ? 'Projects' : sliceBy === 'client' ? 'Clients' : sliceBy === 'tag' ? 'Tags' : 'Billable'}"
                icon="chevrondown" />
            </property>
            <MenuItem onClick="sliceBy = 'billable'">Billable</MenuItem>
            <MenuItem onClick="sliceBy = 'project'">Projects</MenuItem>
            <MenuItem onClick="sliceBy = 'client'">Clients</MenuItem>
            <MenuItem onClick="sliceBy = 'tag'">Tags</MenuItem>
          </DropdownMenu>
        </HStack>
        <Stack height="280px" width="*" horizontalAlignment="center" verticalAlignment="center">
          <PieChart
            cutout="65%"
            showLegend="true"
            data="{distData}"
            dataKey="seconds"
            nameKey="label"
            colors="{sliceBy === 'billable' ? ['#3F8F8C', '#C2BDB7'] : (distData || []).map(d => d.color)}"
          />
        </Stack>
      </Card>
    </HStack>

    <VStack
      when="{vp.value &amp;&amp; vp.value.isMobile}"
      width="*"
      gap="$space-4"
    >
      <Card width="*" padding="$space-6" gap="$space-4">
        <H3>
          Daily hours
        </H3>
        <Stack height="280px" width="*">
          <BarChart
            orientation="vertical"
            data="{dailyTotalsFromEntries(applyReportFilters(((summaryDs.value || {}).entries) || [], projectFilter, tagFilter), fromDate, toDate).map(d => ({ day: d.date.slice(5), hours: Math.round((d.seconds / 3600) * 100) / 100 }))}"
            dataKeys="{['hours']}"
            nameKey="day"
          />
        </Stack>
      </Card>

      <Card width="*" padding="$space-6" gap="$space-4">
        <HStack verticalAlignment="center">
          <H3>{sliceBy === 'project' ? 'Project' : sliceBy === 'client' ? 'Client' : sliceBy === 'tag' ? 'Tag' : 'Billable'} distribution</H3>
          <SpaceFiller />
          <DropdownMenu alignment="end">
            <property name="triggerTemplate">
              <Button
                variant="outlined"
                size="sm"
                label="{sliceBy === 'project' ? 'Projects' : sliceBy === 'client' ? 'Clients' : sliceBy === 'tag' ? 'Tags' : 'Billable'}"
                icon="chevrondown" />
            </property>
            <MenuItem onClick="sliceBy = 'billable'">Billable</MenuItem>
            <MenuItem onClick="sliceBy = 'project'">Projects</MenuItem>
            <MenuItem onClick="sliceBy = 'client'">Clients</MenuItem>
            <MenuItem onClick="sliceBy = 'tag'">Tags</MenuItem>
          </DropdownMenu>
        </HStack>
        <Stack height="280px" width="*" horizontalAlignment="center" verticalAlignment="center">
          <PieChart
            cutout="65%"
            showLegend="true"
            data="{distData}"
            dataKey="seconds"
            nameKey="label"
            colors="{sliceBy === 'billable' ? ['#3F8F8C', '#C2BDB7'] : (distData || []).map(d => d.color)}"
          />
        </Stack>
      </Card>
    </VStack>

    <Card when-xs="false" when-sm="true" gap="$space-4">
      <TextBox
        width="*"
        placeholder="Search description, project, client, tag…"
        startIcon="search"
        testId="reports-search"
        initialValue="{searchText}"
        onDidChange="(v) => searchText = v || ''"
      />
    </Card>

    <Card height="*" when-xs="false" when-sm="true">
      <NoResult
        when="{filterEntries(applyReportFilters(((summaryDs.value || {}).entries) || [], projectFilter, tagFilter), searchText, [], projectsDs.value || [], clientsDs.value || [], tagsDs.value || []).length === 0}"
        label="{searchText || (projectFilter &amp;&amp; projectFilter.length > 0) || (tagFilter &amp;&amp; tagFilter.length > 0)
          ? 'No entries match your filters'
          : 'No entries in this date range'}"
      />
      <VStack
        when-xs="false"
        when-sm="true"
        when="{filterEntries(applyReportFilters(((summaryDs.value || {}).entries) || [], projectFilter, tagFilter), searchText, [], projectsDs.value || [], clientsDs.value || [], tagsDs.value || []).length > 0}"
        gap="0"
      >
        <Theme
          padding-summary-ExpandableItem="$space-2 $space-3"
          paddingHorizontal-content-ExpandableItem="$space-0"
          paddingVertical-content-ExpandableItem="$space-1"
          backgroundColor-summary-ExpandableItem="$color-surface-50"
        >
          <Items
            data="{groupEntriesByDay(entriesForListTable(filterEntries(applyReportFilters(((summaryDs.value || {}).entries) || [], projectFilter, tagFilter), searchText, [], projectsDs.value || [], clientsDs.value || [], tagsDs.value || []), projectsDs.value || []))}"
          >
            <ExpandableItem fullWidthSummary="true" initiallyExpanded="true">
              <property name="summary">
                <HStack verticalAlignment="center" gap="$space-3" width="100%">
                  <Text fontWeight="bold">
                    {$item.date}
                  </Text>
                  <SpaceFiller />
                  <Text variant="secondary" fontWeight="bold">
                    {formatDuration($item.totalSec)}
                  </Text>
                </HStack>
              </property>

              <Table data="{$item.entries || []}">
                <Column bindTo="description" header="Description" width="3*">
                  <VStack gap="$space-1">
                    <Text>
                      {$item.description || '(no description)'}
                    </Text>
                    <HStack
                      gap="$space-1"
                      wrapContent="true"
                      when="{($item.tagIds || []).length > 0}"
                    >
                      <Items data="{tagsForIds($item.tagIds, tagsDs.value || [])}">
                        <Stack
                          backgroundColor="{$item.color}"
                          paddingHorizontal="$space-2"
                          paddingVertical="$space-0"
                          borderRadius="$borderRadius-small"
                        >
                          <Text fontSize="$fontSize-tiny" color="white">
                            {$item.name}
                          </Text>
                        </Stack>
                      </Items>
                    </HStack>
                  </VStack>
                </Column>
                <Column
                  bindTo="projectName"
                  header="Project"
                  width="2*"
                  canSort="true"
                >
                  <HStack gap="$space-2" verticalAlignment="center">
                    <Stack
                      backgroundColor="{projectColor($item.projectId, projectsDs.value || [])}"
                      width="14px"
                      height="14px"
                      borderRadius="3px"
                    />
                    <Text>
                      {$item.projectName}
                    </Text>
                  </HStack>
                </Column>
                <Column header="Time" width="*">
                  <Text>
                    {$item.startTime.slice(11,16)} – {$item.endTime.slice(11,16)}
                  </Text>
                </Column>
                <Column
                  bindTo="durationSeconds"
                  header="Duration"
                  width="*"
                  canSort="true"
                >
                  <Text>
                    {formatDuration($item.durationSeconds)}
                  </Text>
                </Column>
                <Column
                  bindTo="billable"
                  header="Billable"
                  width="*"
                  canSort="true"
                >
                  <Text>
                    {$item.billable ? 'Yes' : 'No'}
                  </Text>
                </Column>
                <Column header="Actions" width="70px">
                  <DropdownMenu alignment="end">
                    <property name="triggerTemplate">
                      <Button
                        icon="dotmenu"
                        variant="ghost"
                        size="sm"
                        themeColor="secondary"
                        testId="row-actions"
                      />
                    </property>
                    <MenuItem
                      icon="copy"
                      onClick="duplicateCall.execute(duplicateEntryPayload($item))"
                    >
                      Duplicate
                    </MenuItem>
                    <MenuItem
                      icon="pencil"
                      onClick="entryModal.open($item)"
                    >
                      Edit
                    </MenuItem>
                    <MenuSeparator />
                    <MenuItem
                      icon="trash"
                      onClick="deleteCall.execute($item.id)"
                    >
                      Delete
                    </MenuItem>
                  </DropdownMenu>
                </Column>
              </Table>
            </ExpandableItem>
          </Items>
        </Theme>
      </VStack>
    </Card>

    <VStack when-xs="true" when-sm="false" gap="$space-2">
      <Card>
        <TextBox
          width="100%"
          placeholder="Search description, project, client, tag…"
          startIcon="search"
          testId="reports-search"
          initialValue="{searchText}"
          onDidChange="(v) => searchText = v || ''"
        />
      </Card>
      <Card when="{filterEntries(applyReportFilters(((summaryDs.value || {}).entries) || [], projectFilter, tagFilter), searchText, [], projectsDs.value || [], clientsDs.value || [], tagsDs.value || []).length === 0}">
        <NoResult
          label="{searchText || (projectFilter &amp;&amp; projectFilter.length > 0) || (tagFilter &amp;&amp; tagFilter.length > 0)
            ? 'No entries match your filters'
            : 'No entries in this date range'}"
        />
      </Card>
      <VStack
        when="{filterEntries(applyReportFilters(((summaryDs.value || {}).entries) || [], projectFilter, tagFilter), searchText, [], projectsDs.value || [], clientsDs.value || [], tagsDs.value || []).length > 0}"
        gap="$space-4"
      >
        <Theme
          padding-summary-ExpandableItem="$space-3"
          paddingHorizontal-content-ExpandableItem="$space-1"
          paddingVertical-content-ExpandableItem="$space-0"
          backgroundColor-ExpandableItem="$color-surface-raised"
          backgroundColor-summary-ExpandableItem="$color-surface-raised"
          backgroundColor-summary-ExpandableItem--hover="transparent"
        >
          <Items
            data="{groupEntriesByDay(entriesForListTable(filterEntries(applyReportFilters(((summaryDs.value || {}).entries) || [], projectFilter, tagFilter), searchText, [], projectsDs.value || [], clientsDs.value || [], tagsDs.value || []), projectsDs.value || []))}"
          >
            <ExpandableItem
              fullWidthSummary="true"
              initiallyExpanded="true"
              border="1px solid $color-surface-200"
              borderRadius="$borderRadius"
            >
              <property name="summary">
                <HStack verticalAlignment="center" gap="$space-2" width="100%">
                  <Stack
                    width="30px"
                    height="30px"
                    borderRadius="50%"
                    backgroundColor="$color-primary-50"
                    horizontalAlignment="center"
                    verticalAlignment="center"
                  >
                    <Icon name="date" color="$color-primary-600" size="14px" />
                  </Stack>
                  <HStack
                    gap="$space-1"
                    verticalAlignment="center"
                    width="*"
                    minWidth="0"
                  >
                    <Text fontWeight="700" fontSize="$fontSize-small">
                      {formatDatePart($item.date)}
                    </Text>
                    <Text variant="secondary" fontSize="$fontSize-tiny">
                      {formatDayPart($item.date)}
                    </Text>
                  </HStack>
                  <Text
                    color="$color-primary-700"
                    fontWeight="700"
                    fontSize="$fontSize-small"
                    width="68px"
                  >
                    {formatDurationCompact($item.totalSec)}
                  </Text>
                </HStack>
              </property>

              <VStack
                gap="$space-3"
                paddingTop="$space-3"
                paddingBottom="$space-3"
              >
                <Items data="{$item.entries || []}">
                  <HStack
                    testId="reports-entry-row"
                    gap="$space-1"
                    width="100%"
                    verticalAlignment="stretch"
                  >
                    <VStack
                      width="32px"
                      gap="$space-1"
                      horizontalAlignment="center"
                    >
                      <HStack gap="$space-0" verticalAlignment="center">
                        <Text
                          color="{projectColor($item.projectId, projectsDs.value || [])}"
                          fontWeight="700"
                          fontSize="$fontSize-tiny"
                        >
                          {$item.startTime.slice(11,16)}
                        </Text>
                      </HStack>
                      <Stack
                        width="1px"
                        height="*"
                        minHeight="88px"
                        backgroundColor="$color-surface-200"
                      />
                    </VStack>

                    <VStack
                      width="*"
                      minWidth="0"
                      gap="$space-2"
                      padding="$space-3"
                      backgroundColor="$color-surface-raised"
                      border="1px solid $color-surface-200"
                      borderRadius="$borderRadius"
                    >
                      <HStack
                        verticalAlignment="start"
                        gap="$space-1"
                        width="100%"
                      >
                        <VStack gap="$space-2" width="*" minWidth="0">
                          <HStack
                            gap="$space-1"
                            verticalAlignment="center"
                            width="100%"
                          >
                            <Text
                              variant="secondary"
                              fontWeight="600"
                              fontSize="$fontSize-tiny"
                              width="104px"
                              whiteSpace="nowrap"
                            >
                              {$item.startTime.slice(11,16)} – {$item.endTime.slice(11,16)}
                            </Text>
                            <SpaceFiller />
                            <Text
                              color="{projectColor($item.projectId, projectsDs.value || [])}"
                              fontWeight="700"
                              fontSize="$fontSize-small"
                              width="64px"
                              whiteSpace="nowrap"
                            >
                              {formatDurationCompact($item.durationSeconds)}
                            </Text>
                          </HStack>
                          <Text
                            fontWeight="700"
                            fontSize="$fontSize-large"
                            width="100%"
                            minWidth="0"
                          >
                            {$item.description || '(no description)'}
                          </Text>
                          <HStack
                            verticalAlignment="center"
                            gap="$space-2"
                            width="100%"
                          >
                            <Stack
                              width="14px"
                              height="14px"
                              borderRadius="3px"
                              backgroundColor="{projectColor($item.projectId, projectsDs.value || [])}"
                            />
                            <Text
                              variant="secondary"
                              fontWeight="600"
                              fontSize="$fontSize-tiny"
                              width="*"
                              minWidth="0"
                            >
                              {$item.projectName}
                            </Text>
                          </HStack>
                        </VStack>

                        <DropdownMenu alignment="end">
                          <property name="triggerTemplate">
                            <Button
                              icon="dotmenu"
                              variant="ghost"
                              size="sm"
                              themeColor="secondary"
                              testId="row-actions"
                              width="28px"
                            />
                          </property>
                          <MenuItem
                            icon="copy"
                            onClick="duplicateCall.execute(duplicateEntryPayload($item))"
                          >
                            Duplicate
                          </MenuItem>
                          <MenuItem
                            icon="pencil"
                            onClick="entryModal.open($item)"
                          >
                            Edit
                          </MenuItem>
                          <MenuSeparator />
                          <MenuItem
                            icon="trash"
                            onClick="deleteCall.execute($item.id)"
                          >
                            Delete
                          </MenuItem>
                        </DropdownMenu>
                      </HStack>

                      <HStack
                        gap="$space-2"
                        width="100%"
                        verticalAlignment="center"
                        wrapContent="true"
                      >
                        <Items data="{tagsForIds($item.tagIds || [], tagsDs.value || [])}">
                          <Stack
                            backgroundColor="{$item.color}"
                            paddingHorizontal="$space-2"
                            paddingVertical="$space-1"
                            borderRadius="$borderRadius-small"
                          >
                            <Text
                              fontSize="$fontSize-tiny"
                              color="white"
                              fontWeight="700"
                            >
                              {$item.name}
                            </Text>
                          </Stack>
                        </Items>
                        <Stack
                          when="{$item.billable}"
                          backgroundColor="$color-primary-50"
                          paddingHorizontal="$space-2"
                          paddingVertical="$space-1"
                          borderRadius="$borderRadius-small"
                        >
                          <HStack gap="$space-1" verticalAlignment="center">
                            <Icon name="check" color="$color-primary-700" />
                            <Text
                              fontSize="$fontSize-tiny"
                              color="$color-primary-700"
                              fontWeight="700"
                            >
                              billable
                            </Text>
                          </HStack>
                        </Stack>
                      </HStack>
                    </VStack>
                  </HStack>
                </Items>
              </VStack>
            </ExpandableItem>
          </Items>
        </Theme>
      </VStack>
    </VStack>
  </VStack>
</Component>
