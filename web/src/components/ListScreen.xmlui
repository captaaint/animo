<Component
  name="ListScreen"
  var.searchText="{''}"
>
  <VStack gap="$space-4">
    <Card gap="$space-4">
      <HStack when-xs="false" when-sm="true" verticalAlignment="center" width="100%" gap="$space-4">
        <HStack verticalAlignment="center" gap="$space-2">
          <Button
            variant="solid"
            size="sm"
            label="◀"
            onClick="emitEvent('weekChange', shiftDate($props.weekStart, -7))"
          />
          <Button
            variant="solid"
            size="sm"
            label="Today"
            onClick="emitEvent('weekChange', mondayOfWeek(new Date()))"
          />
          <Button
            variant="solid"
            size="sm"
            label="▶"
            onClick="emitEvent('weekChange', shiftDate($props.weekStart, 7))"
          />
        </HStack>
        <SpaceFiller />
        <Text fontWeight="bold">
          {formatMonthDay($props.weekStart)}
        </Text>
        <SpaceFiller />
        <HStack gap="$space-4" verticalAlignment="center">
          <HStack gap="$space-1" verticalAlignment="center">
            <Text variant="secondary" fontSize="$fontSize-small">
              Today
            </Text>
            <Text fontWeight="bold">
              {formatDuration(dayTotalSeconds($props.entries || [], toIsoDate(new Date())))}
            </Text>
          </HStack>
          <HStack gap="$space-1" verticalAlignment="center">
            <Text variant="secondary" fontSize="$fontSize-small">
              This week
            </Text>
            <Text fontWeight="bold">
              {formatDuration(weekTotalSeconds($props.entries || [], mondayOfWeek(new Date())))}
            </Text>
          </HStack>
        </HStack>
      </HStack>
      <VStack when-xs="true" when-sm="false" width="100%" gap="$space-2">
        <HStack verticalAlignment="center" width="100%" gap="$space-2">
          <HStack verticalAlignment="center" gap="$space-1">
            <Button
              variant="solid"
              size="sm"
              label="◀"
              onClick="emitEvent('weekChange', shiftDate($props.weekStart, -7))"
            />
            <Button
              variant="solid"
              size="sm"
              label="Today"
              onClick="emitEvent('weekChange', mondayOfWeek(new Date()))"
            />
            <Button
              variant="solid"
              size="sm"
              label="▶"
              onClick="emitEvent('weekChange', shiftDate($props.weekStart, 7))"
            />
          </HStack>
          <SpaceFiller />
          <Text fontWeight="bold">
            {formatMonthDay($props.weekStart)}
          </Text>
        </HStack>
        <HStack gap="$space-2" verticalAlignment="center" horizontalAlignment="center" width="100%">
          <HStack gap="$space-2" verticalAlignment="center">
            <HStack gap="$space-1" verticalAlignment="center">
              <Text variant="secondary" fontSize="$fontSize-tiny">
                Today
              </Text>
              <Text fontWeight="bold" fontSize="$fontSize-small">
                {formatDuration(dayTotalSeconds($props.entries || [], toIsoDate(new Date())))}
              </Text>
            </HStack>
            <HStack gap="$space-1" verticalAlignment="center">
              <Text variant="secondary" fontSize="$fontSize-tiny">
                This week
              </Text>
              <Text fontWeight="bold" fontSize="$fontSize-small">
                {formatDuration(weekTotalSeconds($props.entries || [], mondayOfWeek(new Date())))}
              </Text>
            </HStack>
          </HStack>
        </HStack>
      </VStack>
      <HStack width="100%" gap="$space-2" verticalAlignment="center">
        <TextBox
          width="*"
          placeholder="Search description, project, client, tag…"
          startIcon="search"
          testId="list-search"
          initialValue="{searchText}"
          onDidChange="(v) => searchText = v || ''"
        />
        <Button label="New entry" icon="plus" onClick="emitEvent('addNew')" />
      </HStack>
    </Card>
    <Card height="*">
      <NoResult
        when="{filterEntries($props.entries || [], searchText, [], $props.projects || [], $props.clients || [], $props.tags || []).length === 0}"
        label="{searchText ? 'No entries match your search' : 'No entries this week'}"
      />

      <VStack
        when-xs="false"
        when-sm="true"
        when="{filterEntries($props.entries || [], searchText, [], $props.projects || [], $props.clients || [], $props.tags || []).length > 0}"
        gap="0"
      >
        <Theme
          padding-summary-ExpandableItem="$space-2 $space-3"
          paddingHorizontal-content-ExpandableItem="$space-0"
          paddingVertical-content-ExpandableItem="$space-1"
          backgroundColor-summary-ExpandableItem="$color-surface-50">
          <Items data="{groupEntriesByDay(entriesForListTable(filterEntries($props.entries || [], searchText, [], $props.projects || [], $props.clients || [], $props.tags || []), $props.projects || []))}">
            <ExpandableItem fullWidthSummary="true" initiallyExpanded="true">
              <property name="summary">
                <HStack verticalAlignment="center" gap="$space-3" width="100%">
                  <Text fontWeight="bold">{$item.date}</Text>
                  <SpaceFiller />
                  <Text variant="secondary" fontWeight="bold">
                    {formatDuration($item.totalSec)}
                  </Text>
                </HStack>
              </property>

              <Table data="{$item.entries || []}">
                <Column bindTo="description" header="Description" width="2*">
                  <VStack gap="$space-1">
                    <Text>
                      {$item.description || '(no description)'}
                    </Text>
                    <HStack
                      gap="$space-1"
                      wrapContent="true"
                      when="{($item.tagIds || []).length > 0}"
                    >
                      <Items data="{tagsForIds($item.tagIds, $props.tags || [])}">
                        <Stack
                          backgroundColor="{$item.color}"
                          paddingHorizontal="$space-2"
                          paddingVertical="$space-0"
                          borderRadius="$borderRadius-small"
                        >
                          <Text fontSize="$fontSize-tiny" color="white">
                            {$item.name}
                          </Text>
                        </Stack>
                      </Items>
                    </HStack>
                  </VStack>
                </Column>
                <Column bindTo="projectName" header="Project" width="160px" canSort="true">
                  <HStack gap="$space-2" verticalAlignment="center">
                    <Stack backgroundColor="{projectColor($item.projectId, $props.projects || [])}"
                      width="14px" height="14px" borderRadius="3px" />
                    <Text variant="secondary">{$item.projectName}</Text>
                  </HStack>
                </Column>
                <Column header="Time" width="120px">
                  <Text variant="secondary">
                    {$item.startTime.slice(11,16)} – {$item.endTime.slice(11,16)}
                  </Text>
                </Column>
                <Column bindTo="durationSeconds" header="Duration" width="100px" canSort="true">
                  <Text fontWeight="bold">
                    {formatDuration($item.durationSeconds)}
                  </Text>
                </Column>
                <Column bindTo="billable" header="Billable" width="90px" canSort="true">
                  <Text variant="secondary">
                    {$item.billable ? 'Yes' : 'No'}
                  </Text>
                </Column>
                <Column header="Actions" width="70px">
                  <DropdownMenu alignment="end">
                    <property name="triggerTemplate">
                      <Button
                        icon="dotmenuhorizontal"
                        variant="ghost"
                        size="sm"
                        themeColor="secondary"
                        testId="row-actions"
                      />
                    </property>
                    <MenuItem
                      icon="play"
                      testId="resume-entry"
                      onClick="publishResume($item.description, $item.projectId)"
                    >
                      Resume
                    </MenuItem>
                    <MenuItem
                      icon="copy"
                      testId="duplicate-entry"
                      onClick="emitEvent('duplicateEntry', $item)"
                    >
                      Duplicate
                    </MenuItem>
                    <MenuItem
                      icon="pencil"
                      onClick="emitEvent('openEntry', $item)"
                    >
                      Edit
                    </MenuItem>
                    <MenuSeparator />
                    <MenuItem
                      icon="trash"
                      testId="delete-entry"
                      onClick="emitEvent('deleteEntry', $item)"
                    >
                      Delete
                    </MenuItem>
                  </DropdownMenu>
                </Column>
              </Table>
            </ExpandableItem>
          </Items>
        </Theme>
      </VStack>

      <VStack
        when-xs="true"
        when-sm="false"
        when="{filterEntries($props.entries || [], searchText, [], $props.projects || [], $props.clients || [], $props.tags || []).length > 0}"
        gap="0"
      >
        <Theme
          padding-summary-ExpandableItem="$space-1 $space-3"
          paddingHorizontal-content-ExpandableItem="$space-3"
          paddingVertical-content-ExpandableItem="$space-1"
          backgroundColor-summary-ExpandableItem="$color-primary-50">
          <Items data="{groupEntriesByDay(entriesForListTable(filterEntries($props.entries || [], searchText, [], $props.projects || [], $props.clients || [], $props.tags || []), $props.projects || []))}">
            <ExpandableItem fullWidthSummary="true" initiallyExpanded="true">
              <property name="summary">
                <HStack verticalAlignment="center" gap="$space-3" width="100%">
                  <Text fontWeight="bold">{$item.date}</Text>
                  <SpaceFiller />
                  <Text variant="secondary" fontWeight="bold">
                    {formatDuration($item.totalSec)}
                  </Text>
                </HStack>
              </property>

              <VStack gap="$space-2">
                <Items data="{$item.entries || []}">
                  <ExpandableItem
                    testId="list-entry-row"
                    fullWidthSummary="true"
                    initiallyExpanded="false">
                    <property name="summary">
                      <HStack verticalAlignment="center" gap="$space-3" width="100%">
                        <VStack gap="$space-1" width="*" minWidth="0">
                          <Text fontWeight="600" width="100%" minWidth="0">
                            {$item.description || '(no description)'}
                          </Text>
                          <HStack verticalAlignment="center" gap="$space-2" width="100%">
                            <Stack backgroundColor="{projectColor($item.projectId, $props.projects || [])}"
                              width="10px" height="10px" borderRadius="3px" />
                            <Text variant="secondary" fontSize="$fontSize-small">
                              {$item.projectName}
                            </Text>
                          </HStack>
                        </VStack>
                        <Text fontWeight="bold">
                          {formatDuration($item.durationSeconds)}
                        </Text>
                      </HStack>
                    </property>

                    <VStack gap="$space-2" paddingVertical="0">
                      <HStack gap="$space-2" width="100%" verticalAlignment="center">
                        <Text variant="secondary" fontSize="$fontSize-small" fontWeight="bold">Time</Text>
                        <Text>{$item.startTime.slice(11,16)} – {$item.endTime.slice(11,16)}</Text>
                        <SpaceFiller />
                        <DropdownMenu alignment="end">
                          <property name="triggerTemplate">
                            <Button
                              icon="dotmenuhorizontal"
                              variant="ghost"
                              size="sm"
                              themeColor="secondary"
                              testId="row-actions"
                            />
                          </property>
                          <MenuItem
                            icon="play"
                            testId="resume-entry"
                            onClick="publishResume($item.description, $item.projectId)"
                          >
                            Resume
                          </MenuItem>
                          <MenuItem
                            icon="copy"
                            testId="duplicate-entry"
                            onClick="emitEvent('duplicateEntry', $item)"
                          >
                            Duplicate
                          </MenuItem>
                          <MenuItem
                            icon="pencil"
                            onClick="emitEvent('openEntry', $item)"
                          >
                            Edit
                          </MenuItem>
                          <MenuSeparator />
                          <MenuItem
                            icon="trash"
                            testId="delete-entry"
                            onClick="emitEvent('deleteEntry', $item)"
                          >
                            Delete
                          </MenuItem>
                        </DropdownMenu>
                      </HStack>
                      <HStack gap="$space-2" width="100%" verticalAlignment="center">
                        <Text variant="secondary" fontSize="$fontSize-small" fontWeight="bold">Billable</Text>
                        <Text>{$item.billable ? 'Yes' : 'No'}</Text>
                      </HStack>
                      <HStack gap="$space-2" width="100%" verticalAlignment="center" wrapContent="true"
                        when="{($item.tagIds || []).length > 0}">
                        <Text variant="secondary" fontSize="$fontSize-small" fontWeight="bold">Tags</Text>
                        <HStack gap="$space-1" wrapContent="true">
                          <Items data="{tagsForIds($item.tagIds, $props.tags || [])}">
                            <Stack
                              backgroundColor="{$item.color}"
                              paddingHorizontal="$space-2"
                              paddingVertical="$space-0"
                              borderRadius="$borderRadius-small"
                            >
                              <Text fontSize="$fontSize-tiny" color="white">
                                {$item.name}
                              </Text>
                            </Stack>
                          </Items>
                        </HStack>
                      </HStack>
                    </VStack>
                  </ExpandableItem>
                </Items>
              </VStack>
            </ExpandableItem>
          </Items>
        </Theme>
      </VStack>
    </Card>
  </VStack>
</Component>
