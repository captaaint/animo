<Component name="ClientsScreen">
  <DataSource
    id="clientsDs"
    url="{apiBase + '/clients'}"
    credentials="include"
  />

  <ClientModal id="clientModal" onSaved="() => clientsDs.refetch()" />

  <APICall
    id="deleteCall"
    method="DELETE"
    url="{apiBase + '/clients/' + $param}"
    credentials="include"
    confirmMessage="Are you sure?"
    confirmTitle="Delete client"
    onSuccess="() => { toast.success('Client deleted'); clientsDs.refetch(); }"
    onError="() => toast.error('Delete failed')"
  />

  <VStack
    gap="$space-4"
    padding="0"
    width="100%"
    maxWidth="800px"
    marginHorizontal="auto"
    height="*"
    overflowY="auto"
  >

    <!-- Desktop/tablet: table with combined Client column + Color hex column -->
    <Card when-xs="false" when-sm="true" padding="$space-4">
      <!-- Desktop/tablet: New client button top-right -->
      <HStack when-xs="false" when-sm="true" verticalAlignment="center">
        <SpaceFiller />
        <Button
          label="New client"
          icon="plus"
          onClick="clientModal.open()"
        />
      </HStack>
      <Table
        data="{clientsDs.value || []}"
        when="{(clientsDs.value || []).length > 0}"
      >
        <Column header="Client">
          <HStack verticalAlignment="center" gap="$space-2">
            <Text>
              {$item.name}
            </Text>
          </HStack>
        </Column>
        <Column header="Color" width="160px">
          <HStack verticalAlignment="center" gap="$space-2">
            <Stack
              backgroundColor="{$item.color}"
              width="20px"
              height="20px"
              borderRadius="3px"
            />
            <Text variant="secondary">
              {$item.color}
            </Text>
          </HStack>
        </Column>
        <Column header="" width="100px">
          <HStack gap="$space-1" verticalAlignment="center">
            <Button
              icon="pencil"
              size="xs"
              variant="ghost"
              themeColor="secondary"
              padding="$space-2"
              onClick="clientModal.open($item)"
            />
            <Button
              icon="trash"
              size="xs"
              variant="ghost"
              themeColor="attention"
              padding="$space-2"
              onClick="deleteCall.execute($item.id)"
            />
          </HStack>
        </Column>
      </Table>

      <NoResult
        when="{clientsDs.loaded && (clientsDs.value || []).length === 0}"
        label="No clients yet"
      />
      <Spinner when="{!clientsDs.loaded}" />
    </Card>

    <!-- Mobile: flat list rows with three-dot context menu -->
    <VStack when-xs="true" when-sm="false" gap="$space-3">
      <Card
        when="{(clientsDs.value || []).length > 0}"
        padding="$space-2"
        width="100%"
      >
        <Items data="{clientsDs.value || []}">
          <VStack gap="0">
            <HStack
              verticalAlignment="center"
              paddingVertical="$space-3"
              paddingHorizontal="$space-2"
              gap="$space-3"
            >
              <Stack
                backgroundColor="{$item.color}"
                width="16px"
                height="16px"
                borderRadius="3px"
              />
              <Text fontWeight="500">
                {$item.name}
              </Text>
              <SpaceFiller />
              <DropdownMenu alignment="end">
                <property name="triggerTemplate">
                  <Button
                    icon="dotmenu"
                    variant="ghost"
                    size="sm"
                    themeColor="secondary"
                  />
                </property>
                <MenuItem icon="pencil" onClick="clientModal.open($item)">
                  Edit
                </MenuItem>
                <MenuSeparator />
                <MenuItem icon="trash" onClick="deleteCall.execute($item.id)">
                  Delete
                </MenuItem>
              </DropdownMenu>
            </HStack>
            <ContentSeparator when="{!$isLast}" />
          </VStack>
        </Items>
      </Card>

      <Card
        when="{clientsDs.loaded && (clientsDs.value || []).length === 0}"
        padding="$space-2"
        width="100%"
      >
        <NoResult label="No clients yet" />
      </Card>
      <Spinner when="{!clientsDs.loaded}" />

      <!-- Mobile: full-width New client button at bottom -->
      <Button
        width="100%"
        label="New client"
        icon="plus"
        onClick="clientModal.open()"
      />
    </VStack>

  </VStack>
</Component>