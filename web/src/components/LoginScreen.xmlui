<Component name="LoginScreen">
  <!--
    Receives via props from <AuthGate>'s API:
      $props.signIn  — async (email, password) => void
      $props.loading — boolean
      $props.error   — string | null
  -->
  <CVStack height="*" padding="$space-6">
    <VStack maxWidth="26rem" gap="$space-4" width="100%">
      <H2>Sign in</H2>

      <Form
        data="{{ email: '', password: '' }}"
        enabled="{!$props.loading}"
        saveLabel="{$props.loading ? 'Signing in…' : 'Sign in'}"
        onSubmit="(data) => $props.signIn(data.email, data.password)"
      >
        <TextBox bindTo="email" label="Email" required="true" autoFocus="true" />
        <PasswordInput bindTo="password" label="Password" required="true"
                       showPasswordToggle="true" />
        <property name="buttonRowTemplate">
          <HStack>
            <Button
              type="submit"
              themeColor="primary"
              label="{$props.loading ? 'Signing in…' : 'Sign in'}"
              enabled="{!$props.loading}"
              width="100%"
            />
          </HStack>
        </property>
      </Form>

      <Stack when="{$props.error}"
             padding="$space-3"
             backgroundColor="$color-danger-50"
             borderRadius="$borderRadius">
        <Text color="$color-danger-700" fontSize="$fontSize-small">
          {$props.error}
        </Text>
      </Stack>

      <HStack gap="$space-2">
        <Text>No account?</Text>
        <Link to="/register">Register</Link>
      </HStack>
    </VStack>
  </CVStack>
</Component>
