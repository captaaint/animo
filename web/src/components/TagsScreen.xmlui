<Component name="TagsScreen">
  <DataSource
    id="tagsDs"
    url="{apiBase + '/tags'}"
    credentials="include"
  />

  <Viewport id="vp" />

  <TagModal
    when="{!vp.value || !vp.value.isMobile}"
    id="tagModal"
    onSaved="() => tagsDs.refetch()"
    onDeleteRequested="(item) => deleteConfirmModal.open(item.id)"
  />

  <TagDrawer
    when="{vp.value &amp;&amp; vp.value.isMobile}"
    id="tagDrawer"
    onSaved="() => tagsDs.refetch()"
    onDeleteRequested="(item) => deleteConfirmDrawer.open(item)"
  />

  <DeleteConfirmModal
    when="{!vp.value || !vp.value.isMobile}"
    id="deleteConfirmModal"
    title="Delete tag"
    message="Are you sure you want to delete this tag? This action cannot be undone."
    onConfirmed="(id) => deleteCall.execute(id)"
  />

  <DeleteConfirmDrawer
    when="{vp.value &amp;&amp; vp.value.isMobile}"
    id="deleteConfirmDrawer"
    title="Delete tag"
    confirmText="Delete this tag?"
    message="This action cannot be undone."
    onConfirmed="(id) => deleteCall.execute(id)"
  />

  <APICall
    id="deleteCall"
    method="DELETE"
    url="{apiBase + '/tags/' + $param}"
    credentials="include"
    onSuccess="() => { toast.success('Tag deleted'); tagsDs.refetch(); }"
    onError="() => toast.error('Delete failed')"
  />

  <VStack gap="$space-4" padding="0" width="100%" maxWidth="800px" marginHorizontal="auto"
    height="*" overflowY="auto">

    <!-- Desktop/tablet: table with combined Tag column + Color hex column -->
    <Card when-xs="false" when-sm="true" padding="$space-4">
      <!-- Desktop/tablet: New tag button top-right -->
      <HStack when-xs="false" when-sm="true" verticalAlignment="center">
        <SpaceFiller />
        <Button
          label="New tag"
          icon="plus"
          onClick="tagModal.open()"
        />
      </HStack>
      <Table
        data="{tagsDs.value || []}"
        when="{(tagsDs.value || []).length > 0}"
      >
        <Column header="Tag">
          <HStack verticalAlignment="center" gap="$space-2">
            <Text>{$item.name}</Text>
          </HStack>
        </Column>
        <Column header="Color" width="160px">
          <HStack verticalAlignment="center" gap="$space-2">
            <Stack
              backgroundColor="{$item.color}"
              width="20px"
              height="20px"
              borderRadius="3px"
            />
            <Text variant="secondary">{$item.color}</Text>
          </HStack>
        </Column>
        <Column header="" width="100px">
          <HStack gap="$space-1" verticalAlignment="center">
            <Button icon="pencil" size="xs" variant="ghost" themeColor="secondary" padding="$space-2"
              onClick="tagModal.open($item)" />
            <Button icon="trash" size="xs" variant="ghost" themeColor="attention" padding="$space-2"
              onClick="deleteConfirmModal.open($item.id)" />
          </HStack>
        </Column>
      </Table>

      <NoResult
        when="{tagsDs.loaded && (tagsDs.value || []).length === 0}"
        label="No tags yet"
      />
      <Spinner when="{!tagsDs.loaded}" />
    </Card>

    <!-- Mobile: flat list rows with three-dot context menu -->
    <VStack when-xs="true" when-sm="false" gap="$space-3">
      <Card when="{(tagsDs.value || []).length > 0}" padding="$space-2" width="100%">
        <Items data="{tagsDs.value || []}">
          <VStack gap="0">
            <HStack
              verticalAlignment="center"
              paddingVertical="$space-3"
              paddingHorizontal="$space-2"
              gap="$space-3"
            >
              <Stack backgroundColor="{$item.color}" width="16px" height="16px" borderRadius="3px" />
              <Text fontWeight="500">{$item.name}</Text>
              <SpaceFiller />
              <DropdownMenu alignment="end">
                <property name="triggerTemplate">
                  <Button icon="dotmenu" variant="ghost" size="sm" themeColor="secondary" />
                </property>
                <MenuItem icon="pencil" onClick="tagDrawer.open($item)">Edit</MenuItem>
                <MenuSeparator />
                <MenuItem icon="trash" onClick="deleteConfirmDrawer.open($item)">Delete</MenuItem>
              </DropdownMenu>
            </HStack>
            <ContentSeparator when="{!$isLast}" />
          </VStack>
        </Items>
      </Card>

      <Card when="{tagsDs.loaded && (tagsDs.value || []).length === 0}"
        padding="$space-2" width="100%">
        <NoResult label="No tags yet" />
      </Card>
      <Spinner when="{!tagsDs.loaded}" />

      <!-- Mobile: full-width New tag button at bottom -->
      <Button
        width="100%"
        label="New tag"
        icon="plus"
        onClick="tagDrawer.open()"
      />
    </VStack>

  </VStack>
</Component>
