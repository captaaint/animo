<Component name="RegisterScreen">
  <!--
    Receives via props from <AuthGate>'s API:
      $props.register — async (email, password, name) => void
      $props.loading  — boolean
      $props.error    — string | null
  -->
  <CVStack height="*" padding="$space-6">
    <VStack maxWidth="26rem" gap="$space-4" width="100%">
      <H2>Create account</H2>

      <Form
        data="{{ name: '', email: '', password: '' }}"
        enabled="{!$props.loading}"
        saveLabel="{$props.loading ? 'Creating account…' : 'Create account'}"
        onSubmit="(data) => $props.register(data.email, data.password, data.name)"
      >
        <TextBox bindTo="name" label="Full name" required="true" autoFocus="true" />
        <TextBox bindTo="email" label="Email" required="true" />
        <PasswordInput bindTo="password" label="Password" required="true"
                       minLength="8" showPasswordToggle="true" />
        <property name="buttonRowTemplate">
          <HStack>
            <Button
              type="submit"
              themeColor="primary"
              label="{$props.loading ? 'Creating account…' : 'Create account'}"
              enabled="{!$props.loading}"
              width="100%"
            />
          </HStack>
        </property>
      </Form>

      <Stack when="{$props.error}"
             padding="$space-3"
             backgroundColor="$color-danger-50"
             borderRadius="$borderRadius">
        <Text color="$color-danger-700" fontSize="$fontSize-small">
          {$props.error}
        </Text>
      </Stack>

      <HStack gap="$space-2">
        <Text>Have an account?</Text>
        <Link to="/login">Sign in</Link>
      </HStack>
    </VStack>
  </CVStack>
</Component>
