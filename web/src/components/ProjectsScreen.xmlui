<Component name="ProjectsScreen">
  <DataSource
    id="projectsDs"
    url="{apiBase + '/projects'}"
    credentials="include"
  />
  <DataSource
    id="clientsDs"
    url="{apiBase + '/clients'}"
    credentials="include"
  />

  <ProjectModal
    id="projectModal"
    clients="{clientsDs.value || []}"
    onSaved="() => projectsDs.refetch()"
  />

  <APICall
    id="deleteCall"
    method="DELETE"
    url="{apiBase + '/projects/' + $param}"
    credentials="include"
    confirmMessage="Are you sure?"
    confirmTitle="Delete project"
    onSuccess="() => { toast.success('Project deleted'); projectsDs.refetch(); }"
    onError="() => toast.error('Delete failed')"
  />

  <VStack gap="$space-4" padding="0" width="100%" maxWidth="800px" marginHorizontal="auto"
    height="*" overflowY="auto">

    <!-- Desktop + tablet view: the original Table inside a single Card. -->
    <Card when-xs="false" when-sm="true" padding="$space-2">
      <Table
        data="{projectsDs.value || []}"
        when="{(projectsDs.value || []).length > 0}"
      >
        <Column header="Color" width="80px">
          <Stack backgroundColor="{$item.color}" width="20px" height="20px"
            borderRadius="3px" />
        </Column>
        <Column bindTo="name" header="Name" />
        <Column header="Client">
          <Text>
            {((clientsDs.value || []).find(c => c.id === $item.clientId) || {}).name || '—'}
          </Text>
        </Column>
        <Column header="Rate" width="120px">
          <Text>
            {$item.hourlyRate &amp;&amp; $item.hourlyRate > 0
            ? ($item.hourlyRate + ' ' + ($item.currency || 'EUR') + '/h')
            : '—'}
          </Text>
        </Column>
        <Column header="Actions" width="100px">
          <HStack gap="$space-1" verticalAlignment="center">
            <Button icon="pencil" size="xs" variant="ghost" padding="$space-2"
              onClick="projectModal.open($item)" />
            <Button icon="trash" size="xs" variant="ghost" themeColor="attention" padding="$space-2"
              onClick="deleteCall.execute($item.id)" />
          </HStack>
        </Column>
      </Table>

      <NoResult
        when="{projectsDs.loaded &amp;&amp; (projectsDs.value || []).length === 0}"
        label="No projects yet"
      />
      <Spinner when="{!projectsDs.loaded}" />
    </Card>

    <!-- Mobile view: collapsible items in one Card with Mist-tinted summaries. -->
    <VStack when-xs="true" when-sm="false" gap="0">
      <Card when="{(projectsDs.value || []).length > 0}" padding="$space-2" width="100%">
        <Theme
          padding-summary-ExpandableItem="$space-1 $space-4"
          paddingHorizontal-content-ExpandableItem="$space-4"
          paddingVertical-content-ExpandableItem="$space-1"
          backgroundColor-summary-ExpandableItem="$color-primary-50">
          <Items data="{projectsDs.value || []}">
            <ExpandableItem fullWidthSummary="true" initiallyExpanded="true">
              <property name="summary">
                <HStack verticalAlignment="center" gap="$space-3">
                  <Stack backgroundColor="{$item.color}" width="14px" height="14px"
                    borderRadius="3px" />
                  <Text fontWeight="600">{$item.name}</Text>
                </HStack>
              </property>

              <VStack gap="$space-2" paddingVertical="0">
                <HStack gap="$space-2" width="100%" verticalAlignment="center">
                  <Text variant="secondary" fontSize="$fontSize-small" fontWeight="bold">Client</Text>
                  <Text>
                    {((clientsDs.value || []).find(c => c.id === $item.clientId) || {}).name || '—'}
                  </Text>
                  <SpaceFiller />
                  <HStack gap="$space-1" verticalAlignment="center">
                    <Button icon="pencil" size="xs" variant="ghost" padding="$space-2"
                      onClick="projectModal.open($item)" />
                    <Button icon="trash" size="xs" variant="ghost" themeColor="attention" padding="$space-2"
                      onClick="deleteCall.execute($item.id)" />
                  </HStack>
                </HStack>
                <HStack gap="$space-2" width="100%" verticalAlignment="center">
                  <Text variant="secondary" fontSize="$fontSize-small" fontWeight="bold">Rate</Text>
                  <Text>
                    {$item.hourlyRate &amp;&amp; $item.hourlyRate > 0
                    ? ($item.hourlyRate + ' ' + ($item.currency || 'EUR') + '/h')
                    : '—'}
                  </Text>
                </HStack>
              </VStack>
            </ExpandableItem>
          </Items>
        </Theme>
      </Card>

      <Card when="{projectsDs.loaded &amp;&amp; (projectsDs.value || []).length === 0}"
        padding="$space-2" width="100%">
        <NoResult label="No projects yet" />
      </Card>
      <Spinner when="{!projectsDs.loaded}" />
    </VStack>

    <HStack verticalAlignment="center">
      <Button
        label="New project"
        icon="plus"
        onClick="projectModal.open()"
      />
    </HStack>
  </VStack>
</Component>
