{
  "name": "animo-blocks",
  "version": "0.2.2",
  "private": true,
  "type": "module",
  "sideEffects": [
    "**/*.css",
    "**/*.scss"
  ],
  "description": "Shared XMLUI extension components used by animo/app and animo/website.",
  "exports": {
    ".": {
      "types": "./src/index.tsx",
      "default": "./dist/animo-blocks.mjs"
    }
  },
  "scripts": {
    "build:extension": "xmlui build-lib",
    "build-watch": "xmlui build-lib --watch",
    "build:meta": "xmlui build-lib --mode=metadata"
  },
  "dependencies": {
    "@ark-ui/react": "^5.36.2"
  },
  "devDependencies": {
    "xmlui": "*"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=18.0.0"
  },
  "clean-package": {
    "replace": {
      "exports": {
        ".": {
          "import": "./dist/animo-blocks.mjs",
          "require": "./dist/animo-blocks.js"
        },
        "./*.css": {
          "import": "./dist/*.css"
        }
      }
    }
  }
}
